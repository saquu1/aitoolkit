          "tables": ["Organizations", "OrganizationTypes", "OrganizationBranches", "OrganizationSettings", "OrganizationLicenses"],
          "dependsOn": [],
          "priority": "critical",
          "revenue": false,
          "estimatedDays": 5
        },
        {
          "key": "user-auth",
