/// Building - Parent entity for the organization's physical structure
/// Features: CRUD, search, pagination, sorting
model OrganizationBuilding {
  id            String         @id @default(cuid())
  projectId     String
  
  // Core Fields
  buildingName  String
  description   String?
  status        Boolean        @default(true) // true = Active, false = Inactive
  
  // Audit Fields
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  
  // Relations
  floors        OrganizationFloor[]
  
  @@unique([projectId, buildingName])
  @@index([projectId])
  @@index([buildingName])
  @@index([status])
  @@index([createdAt])
  @@map("organization_buildings")
}

/// Floor - Child entity linked to Building
/// Features: CRUD, cascading from Building selection
model OrganizationFloor {
  id            String         @id @default(cuid())
  projectId     String
  buildingId    String
  
  // Core Fields
  floorName     String
  description   String?
  status        Boolean        @default(true) // true = Active, false = Inactive
  
  // Audit Fields
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  
  // Relations
  building      OrganizationBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms         OrganizationRoom[]
  
  @@unique([buildingId, floorName])
  @@index([projectId])
  @@index([buildingId])
  @@index([floorName])
  @@index([status])
  @@index([createdAt])
  @@map("organization_floors")
}

/// Room - Grandchild entity linked to Floor and Building
/// Features: CRUD, cascading dropdowns (select Building first -> Floor populates)
model OrganizationRoom {
  id            String         @id @default(cuid())
  projectId     String
  buildingId    String
  floorId       String
  
  // Core Fields
  roomName      String
  description   String?
  status        Boolean        @default(true) // true = Active, false = Inactive
  
  // Audit Fields
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  
  // Relations
  floor         OrganizationFloor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  
  @@unique([floorId, roomName])
  @@index([projectId])
  @@index([buildingId])
  @@index([floorId])
  @@index([roomName])
  @@index([status])
  @@index([createdAt])
  @@map("organization_rooms")
}

