  session        AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pattern        AIPattern @relation(fields: [patternId], references: [id])

  @@unique([patternId, sessionId, filepath])
  @@index([patternId])
  @@index([sessionId])
}

model AnomalyAlert {
  id             String        @id @default(cuid())
  sessionId      String?
  anomalyType    AnomalyType
  severity       AlertSeverity
  metricName     String
  metricValue    Float
  expectedValue  Float
  threshold      Float
  zScore         Float?
  description    String?
  relatedFile    String?
  relatedPattern String?
  status         AlertStatus   @default(OPEN)
  resolution     String?
  resolvedBy     String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
  session        AISession?    @relation(fields: [sessionId], references: [id])

  @@index([anomalyType])
  @@index([severity])
  @@index([status])
  @@index([sessionId])
}

model TrendSnapshot {
  id                 String      @id @default(cuid())
  period             TrendPeriod
  periodStart        DateTime
  periodEnd          DateTime
  sessionsCount      Int         @default(0)
  issuesCount        Int         @default(0)
  featuresCount      Int         @default(0)
  repeatIssues       Int         @default(0)
  totalTokens        Int         @default(0)
  totalCostUSD       Float       @default(0)
  avgCostPerSession  Float       @default(0)
  efficiencyScore    Float       @default(0)
  qualityScore       Float       @default(0)
  firstAttemptRate   Float       @default(0)
  totalFilesCreated  Int         @default(0)
  totalFilesModified Int         @default(0)
  totalLinesAdded    Int         @default(0)
  avgSessionDuration Float       @default(0)
  avgReasoningTime   Float       @default(0)
  avgToolTime        Float       @default(0)
  modelDistribution  String      @default("{}")
  vsPreviousPeriod   String      @default("{}")
  anomaliesDetected  Int         @default(0)
  patternsDetected   Int         @default(0)
  createdAt          DateTime    @default(now())

  @@unique([period, periodStart])
  @@index([period])
  @@index([periodStart])
}

// =============================================================================
// ERROR LOG & PATTERN DETECTION
// =============================================================================

model ErrorLog {
  id            String      @id @default(cuid())
  requestId     String
  timestamp     DateTime    @default(now())
  status        Int         @default(0)
  statusText    String      @default("")
  type          String      @default("UNKNOWN")        // BUSINESS_LOGIC, VALIDATION_ERROR, AUTH_ERROR, SERVER_FAILURE, NETWORK_ERROR
  severity      String      @default("error")          // info, warning, error, critical
  message       String
  hint          String?
  endpoint      String
  method        String      @default("GET")
  duration      Int?
  context       String      @default("{}")
  retryable     Boolean     @default(false)
  retryCount    Int         @default(0)
  userAgent     String?
  url           String?
  acknowledged  Boolean     @default(false)
  acknowledgedAt DateTime?
  patternId     String?
  createdAt     DateTime    @default(now())

  ErrorPattern  ErrorPattern? @relation(fields: [patternId], references: [id])

  @@index([timestamp])
  @@index([severity])
  @@index([type])
  @@index([status])
  @@index([endpoint])
  @@index([acknowledged])
  @@index([patternId])
}

model ErrorPattern {
  id                String      @id @default(cuid())
  patternKey        String      @unique
  patternName       String
  errorType         String
  endpoint          String?
  httpStatus        Int?
  description       String
  rootCause         String?
  howItHappened     String?
  preventionStrategy String?
  autoFixSolution   String?
  occurrenceCount   Int         @default(0)
  lastOccurrence    DateTime    @default(now())
  firstOccurrence   DateTime    @default(now())
  patternStatus     String      @default("ACTIVE")  // ACTIVE, MONITORING, RESOLVED
  severity          String      @default("warning")
  estimatedTimeSaved Int        @default(0)
  estimatedTokensSaved Int      @default(0)
  estimatedCostSaved Float      @default(0)
  tags              String      @default("[]")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  ErrorLog          ErrorLog[]

  @@index([errorType])
  @@index([patternStatus])
  @@index([severity])
  @@index([endpoint])
}

// Saved AI Error Solutions - Store successful fixes for future use
model SavedErrorSolution {
  id                String   @id @default(cuid())
  errorType         String
  httpStatus        Int
  errorPattern      String
  solution          String
  codeFix           String?
  confidence        Int      @default(80)
  successRate       Int      @default(100)
  usageCount        Int      @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([errorType])
  @@index([httpStatus])
  @@index([successRate])
}

// Autoload Configuration - Control which pages auto-fetch data
model AutoloadConfig {
  id            String    @id @default(cuid())
  pageKey       String    @unique    // e.g., 'dashboard', 'modules', 'projects'
  pageName      String               // Human readable name
  category      String    @default("general") // e.g., 'core', 'analytics', 'management'
  enabled       Boolean   @default(true)     // Is autoload enabled?
  description   String?                      // What data is loaded
  fetchEndpoint String?                      // API endpoint called on load
  lastToggledAt DateTime?                    // When was it last toggled
  toggledBy     String?                      // Who toggled it (for future multi-user)
  reason        String?                      // Why disabled (optional note)
  priority      Int       @default(5)        // 1-10, lower = less critical
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
  @@index([category])
  @@index([pageKey])
}


