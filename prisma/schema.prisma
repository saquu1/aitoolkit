  @@index([toolName])
  @@index([filepath])
  @@index([hasError])
}

model FileOperation {
  id             String        @id @default(cuid())
  sessionId      String
  filepath       String
  operation      FileOpType
  linesAdded     Int           @default(0)
  linesRemoved   Int           @default(0)
  netLines       Int           @default(0)
  contentHash    String?
  contentSize    Int           @default(0)
  fileType       String?
  fileCategory   FileCategory?
  errorCount     Int           @default(0)
  editCount      Int           @default(0)
  tokensConsumed Int           @default(0)
  costUSD        Float         @default(0)
  createdAt      DateTime      @default(now())
  session        AISession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([filepath])
  @@index([fileCategory])
  @@index([operation])
}

model GitOperation {
  id             String    @id @default(cuid())
  sessionId      String
  operationType  GitOpType
  commitHash     String?
  commitMessage  String?
  filesChanged   Int?
  insertions     Int?
  deletions      Int?
  remoteName     String?
  branchName     String?
  forced         Boolean   @default(false)
  success        Boolean   @default(true)
  errorMessage   String?
  tokensConsumed Int       @default(0)
  costUSD        Float     @default(0)
  timestamp      DateTime
  session        AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([operationType])
  @@index([commitHash])
}

model PatternOccurrence {
  id             String    @id @default(cuid())
  patternId      String
  sessionId      String
  filepath       String?
  lineNumber     Int?
  matchedContent String?
  autoFixed      Boolean   @default(false)
  fixApplied     String?
