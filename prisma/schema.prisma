  createdAt         DateTime         @default(now())
  session           AISession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([blockType])
  @@index([containsError])
}

model ToolCall {
  id               String    @id @default(cuid())
  sessionId        String
  externalCallId   String?
  toolName         ToolName
  description      String?
  command          String?
  filepath         String?
  oldContent       String?
  newContent       String?
  resultContent    String?
  resultStatus     String?
  startedAt        DateTime?
  endedAt          DateTime?
  durationMs       Int?
  isGitOperation   Boolean   @default(false)
  isBuildCommand   Boolean   @default(false)
  isTestCommand    Boolean   @default(false)
  isServerCommand  Boolean   @default(false)
  isFileOperation  Boolean   @default(false)
  isReadOperation  Boolean   @default(false)
  isWriteOperation Boolean   @default(false)
  isEditOperation  Boolean   @default(false)
  isTodoWrite      Boolean   @default(false)
  isDangerous      Boolean   @default(false)
  hasError         Boolean   @default(false)
  errorMessage     String?
  arguments        String    @default("{}")
  result           String?
  isRetry          Boolean   @default(false)
  retryOfId        String?
  retryCount       Int       @default(0)
