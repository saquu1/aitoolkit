/// SP Classification Rule - 30+ naming pattern classification rules
model SPClassificationRule {
  id                    String   @id @default(cuid())
  
  // Pattern matching
  pattern               String   @unique // Regex pattern e.g., "^SP_DDL_"
  patternFlags          String   @default("i") // Regex flags (i = case insensitive)
  
  // Classification result
  actionType            String   // dropdown, read_single, read_list, create, update, delete, etc.
  httpMethod            String   @default("GET") // GET, POST, PUT, DELETE, PATCH
  
  // Route generation
  routePattern          String   // "/api/{module}/{entity}/dropdown"
  routeTemplate         String?  // Full route template with parameter mapping
  
  // Behavior flags
  isTransactional       Boolean  @default(false)
  requiresAuth          Boolean  @default(true)
  isCacheable           Boolean  @default(false)
  cacheTTL              Int?     // Cache TTL in seconds
  
  // Priority & risk
  priority              String   @default("medium") // critical, high, medium, low
  riskLevel             String   @default("low") // low, medium, high, critical
  
  // Metadata
  description           String?
  examples              String   @default("[]") // JSON: example SP names
  category              String   @default("general") // crud, dropdown, report, workflow, interface
  
  // Status
  isActive              Boolean  @default(true)
  matchCount            Int      @default(0) // How many SPs matched this rule
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([actionType])
  @@index([httpMethod])
  @@index([isActive])
  @@index([category])
}

/// SP Business Rule - Detailed business rules extracted from SP bodies
model SPBusinessRule {
  id                    String   @id @default(cuid())
  projectId             String
  spName                String
  
  // Rule identification
  ruleId                String   // "BR-PAT-ADM-001"
  ruleType              String   // existence_check, availability_check, status_check, 
                                // permission_check, date_range_check, uniqueness_check,
                                // referential_check, calculation_check, limit_check
  ruleName              String   // Human-readable rule name
  
  // Condition details
  description           String   // What the rule checks
  tableName             String   // Table involved in the condition
  conditionSQL          String   // SQL condition snippet
  conditionNormalized   String?  // Normalized condition for analysis
  
  // Business context
  businessContext       String?  // Why this rule exists
  errorHandlingType     String   @default("blocking") // blocking, warning, informational
  
  // Error mapping
  errorCode             Int?     // SP error code (-1, -2, etc.)
  errorMessage          String?  // SP error message
  userFriendlyMessage   String?  // User-friendly message
  
  // CSHTML correlation
  cshtmlValidation      String?  // Matching CSHTML validation rule
  cshtmlErrorMessage    String?  // CSHTML error message
  validationAlignment   String   @default("unknown") // aligned, mismatched, missing_cshtml, missing_sp
  
  // Migration
  migratedTo            String?  // Where this rule migrated to (middleware path)
  migrationComplexity   String   @default("simple") // simple, moderate, complex
  migrationNotes        String?
  
  // Confidence
  extractionConfidence  Float    @default(0.8)
  verifiedBy            String?  // User who verified
  verifiedAt            DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, spName, ruleId])
  @@index([projectId])
  @@index([spName])
  @@index([ruleType])
  @@index([errorCode])
  @@index([validationAlignment])
}

/// SP Correlation - CSHTML ↔ SP correlation with field mappings
model SPCorrelation {
  id                    String   @id @default(cuid())
  projectId             String
  
  // Entities being correlated
  spName                String
  cshtmlViewName        String
  cshtmlViewPath        String?
  
  // Correlation metadata
  correlationType       String   // form_to_insert_sp, form_to_update_sp, grid_to_list_sp,
                                // dropdown_to_ddl_sp, ajax_to_action_sp, 
                                // validation_to_check_sp, search_to_search_sp
  correlationMethod     String   // url_match, field_match, pattern_inference, ai_match
  
  // Confidence scoring
  confidence            Float    @default(0.0) // 0.0 to 1.0
  confidenceBreakdown   String   @default("{}") // JSON: {urlMatch: 0.95, fieldMatch: 0.85, ...}
  
  // Field mappings
  fieldMappings         String   @default("[]") // JSON: FieldMapping[]
  // [{cshtmlField, spParameter, matchMethod, confidence, typeCompatible, validationAlignment}]
  
  // Unmatched items
  unmatchedCSHTMLFields String   @default("[]") // Fields in CSHTML not in SP
  unmatchedSPParams     String   @default("[]") // Parameters in SP not in CSHTML
  
  // Type conflicts
  typeConflicts         String   @default("[]") // JSON: TypeConflict[]
  // [{field, cshtmlType, spType, suggestion}]
  
  // Validation alignment
  validationGaps        String   @default("[]") // Missing validations
  validationExcessive   String   @default("[]") // Extra validations not needed
  
  // Status
  status                String   @default("pending") // pending, verified, rejected, needs_review
  verifiedBy            String?
  verifiedAt            DateTime?
  reviewNotes           String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, spName, cshtmlViewName])
  @@index([projectId])
  @@index([spName])
  @@index([cshtmlViewName])
  @@index([correlationType])
  @@index([status])
  @@index([confidence])
}

/// SP Error Code - Mapping between SP error codes and CSHTML messages
model SPErrorCodeMapping {
  id                    String   @id @default(cuid())
  projectId             String
  spName                String
  
  // Error code details
  errorCode             Int      // -1, -2, -3, etc.
  errorType             String   // business_rule, validation, system_error, permission
  spErrorMessage        String?  // Original SP error message
  
  // CSHTML mapping
  cshtmlViewName        String?
  cshtmlHandler         String?  // AJAX error handler code snippet
  cshtmlUserMessage     String?  // User-facing message in CSHTML
  
  // Normalized output
  userFriendlyMessage   String   // Standardized user message
  suggestedHTTPStatus   Int      @default(400) // 400, 403, 404, 409, 422, 500
  
  // Business context
  businessRule          String?  // Reference to SPBusinessRule
  severity              String   @default("error") // error, warning, info
  
  // Localization support
  messageKey            String?  // For i18n
  messageVariables      String   @default("[]") // Variables for message interpolation
  
  // Status
  isResolved            Boolean  @default(false)
  migratedToCode        String?  // Where this is now handled
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, spName, errorCode])
  @@index([projectId])
  @@index([spName])
  @@index([errorCode])
  @@index([errorType])
}

/// API Route Generation - Generated Next.js API routes from SPs
model APIRouteGeneration {
  id                    String   @id @default(cuid())
  projectId             String
  spName                String
  
  // Route definition
  httpMethod            String   // GET, POST, PUT, DELETE, PATCH
  routePath             String   // "/api/organization"
  routeName             String   // "createOrganization"
  
  // Module mapping
  moduleName            String?
  entityName            String?
  
  // Generated code
  generatedTypeScript   String?  // Full generated TypeScript code
  generatedZodSchema    String?  // Zod validation schema
  generatedTypes        String?  // TypeScript type definitions
  
  // Code sections (for incremental generation)
  importsSection        String   @default("")
  schemaSection         String   @default("")
  handlerSection        String   @default("")
  middlewareSection     String   @default("")
  errorHandlingSection  String   @default("")
  
  // SP parameter mapping
  parameterMappings     String   @default("[]") // JSON: ParameterMapping[]
  // [{spParam, httpSource, tsType, required, defaultValue, validation}]
  
  // Response mapping
  responseMapping       String   @default("{}") // JSON: response structure
  
  // Error code mapping
  errorMappings         String   @default("[]") // JSON: ErrorMapping[]
  // [{errorCode, httpStatus, message}]
  
  // Middleware requirements
  requiredMiddleware    String   @default("[]") // ["auth", "permission", "audit", "validation"]
  requiredPermissions   String   @default("[]") // ["Organization.CanAdd"]
  
  // Generation metadata
  generationConfidence  Float    @default(0.0)
  generationSource      String   @default("sp") // sp, manual, hybrid
  generationVersion     Int      @default(1)
  
  // Status
  status                String   @default("generated") // generated, reviewed, implemented, deployed
  reviewedBy            String?
  reviewedAt            DateTime?
  implementedAt         DateTime?
  deployedAt            DateTime?
  
  // Quality metrics
  testCoverage          Float    @default(0.0)
  documentationComplete Boolean  @default(false)
  
  // File output
  outputFilePath        String?  // Where the file was saved
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, spName, httpMethod])
  @@index([projectId])
  @@index([spName])
  @@index([httpMethod])
  @@index([moduleName])
  @@index([status])
}

/// Dropdown Registry - Catalog of all DDL (dropdown) stored procedures
model DropdownRegistry {
