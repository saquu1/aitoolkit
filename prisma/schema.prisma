/// CSHTML Form Intelligence - Detailed form analysis from CSHTML
model CSHTMLFormIntelligence {
  id                    String   @id @default(cuid())
  projectId             String
  viewName              String
  formId                String?  // HTML form ID
  formName              String?  // Form name
  
  // Form configuration
