/// SP Workflow Chain - Sequence of SPs that form a business process
model SPWorkflowChain {
  id                String   @id @default(cuid())
  projectId         String

  // Chain Info
  chainId           String   @unique
  chainName         String
  description       String?

  // Process Type
  processType       String   @default("unknown") // registration, admission, billing, discharge, etc.
  moduleName        String?

  // Chain Steps
  steps             String   @default("[]") // JSON: WorkflowStep[]
  // { order, spName, actionType, description, inputMapping, outputMapping }

  // Statistics
  totalSteps        Int      @default(0)
  estimatedDuration Int      @default(0) // milliseconds

  // Entry Points
  entryPoints       String   @default("[]") // JSON: string[] - SP names that start the chain

  // Status
  status            String   @default("discovered") // discovered, validated, implemented

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([processType])
  @@index([moduleName])
}

/// SP Dependency Graph - Tracks which SPs call other SPs
model SPDependencyGraph {
  id                String   @id @default(cuid())
  projectId         String

  // Caller SP
  callerSP          String

  // Called SP
  calledSP          String

  // Call Details
  callType          String   @default("exec") // exec, dynamic_sql, trigger
  parameterMapping  String   @default("[]") // JSON: {from: param, to: param}[]

  // Context
  lineNumber        Int?
  context           String?

  createdAt         DateTime @default(now())

  @@unique([projectId, callerSP, calledSP])
  @@index([projectId])
  @@index([callerSP])
  @@index([calledSP])
}

