/// Report - Report definition
model Report {
  id                String   @id @default(cuid())
  projectId         String
  
  // Module relation
  moduleId          String?
  
  // Report Identity
  reportKey         String   @unique
  name              String
  
  // Description
  description       String?
  businessPurpose   String?
  
  // Source
  sourceView        String?  // Database view
  sourceTable       String?  // Main table
  sourceSP          String?  // Stored procedure
  
  // Type
  reportType        String   @default("tabular") // tabular, summary, chart, matrix
  
  // Configuration
  columns           String   @default("[]") // JSON: ReportColumn[]
  groupBy           String   @default("[]") // JSON: string[]
  orderBy           String   @default("[]") // JSON: {column, direction}[]
  
  // Export
  exportFormats     String   @default("[\"pdf\",\"excel\",\"csv\"]") // JSON: string[]
  
  // Status
  status            String   @default("draft") // draft, active, deprecated
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  filters           ReportFilter[]
  
  @@index([projectId])
  @@index([moduleId])
  @@index([reportType])
}

/// Report Filter - Report filter definition
model ReportFilter {
  id                String   @id @default(cuid())
  reportId          String
  
  // Filter Identity
  filterKey         String   // Unique key
  filterName        String
  
  // Filter Type
  filterType        String   @default("text") // text, dropdown, date, dateRange, number, multiSelect
  
  // Configuration
  columnName        String   // Database column
  operator          String   @default("=") // =, !=, >, <, >=, <=, like, in, between
  defaultValue      String?
  
  // UI
  isRequired        Boolean  @default(false)
  isVisible         Boolean  @default(true)
  
  // Options (for dropdown/multiSelect)
  options           String   @default("[]") // JSON: FilterOption[]
  
  // Position
  position          Int      @default(0)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  report            Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  @@unique([reportId, filterKey])
  @@index([reportId])
}

