/// Page - Represents a UI page/screen
model Page {
  id                String   @id @default(cuid())
  projectId         String
  
  // Module relation
  moduleId          String?
  
  // Page Info
  name              String
  urlSlug           String
  title             String?
  
  // Layout
  layout            String   @default("_Layout") // Layout file name
  pageType          String   @default("form") // form, list, detail, dashboard
  
  // Source
  sourceFile        String?  // Original CSHTML file
  sourceTable       String?  // Linked database table
  
  // Migration
  migrationStatus   String   @default("pending") // pending, in_progress, completed, skipped
  reactPath         String?  // Generated React component path
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  components        PageComponent[]
  forms             Form[]
  
  @@unique([projectId, urlSlug])
  @@index([projectId])
  @@index([moduleId])
  @@index([pageType])
}

/// Page Component - UI components within a page
model PageComponent {
  id                String   @id @default(cuid())
  pageId            String
  
  // Component Identity
  componentType     String   // form, grid, tab, modal, chart, card, table
  componentName     String
  
  // Hierarchy
  parentComponentId String?
  
  // Position
  position          Int      @default(0)
  
  // Properties
  props             String   @default("{}") // JSON: component properties
  
  // Content
  content           String?  // Static content or template
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  page              Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent            PageComponent?    @relation("ComponentHierarchy", fields: [parentComponentId], references: [id], onDelete: SetNull)
  children          PageComponent[]   @relation("ComponentHierarchy")
  
  @@index([pageId])
  @@index([componentType])
  @@index([parentComponentId])
}

// ============================================================================
// FORM DESIGNER MODELS
// ============================================================================

/// Form - Form definition
model Form {
  id                String   @id @default(cuid())
  pageId            String?
  projectId         String
  
  // Form Identity
  name              String
  formKey           String   @unique // Unique identifier
  
  // Form Configuration
  method            String   @default("POST") // GET, POST, PUT, DELETE
  actionUrl         String?
  enctype           String   @default("application/x-www-form-urlencoded")
  
  // Source
  sourceTable       String?  // Linked database table
  sourceSP          String?  // Linked stored procedure
  
  // Validation
  validationEnabled Boolean  @default(true)
  customValidation  String?  // Custom validation function
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  page              Page?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fields            FormField[]
  
  @@index([projectId])
  @@index([sourceTable])
}

/// Form Field - Individual form field
model FormField {
  id                String   @id @default(cuid())
  formId            String
  
  // Field Identity
  fieldName         String
  fieldKey          String   // Unique key
  
  // Field Type
  fieldType         String   @default("text_input") // text_input, textarea, dropdown, checkbox, radio, date_picker, etc.
  uiComponent       String?  // Custom UI component
  
  // Display
  label             String
  placeholder       String?
  helpText          String?
  
  // Validation
  validationRules   String   @default("[]") // JSON: ValidationRule[]
  isRequired        Boolean  @default(false)
  isReadOnly        Boolean  @default(false)
  
  // Default Value
  defaultValue      String?
  
  // Position
  position          Int      @default(0)
  section           String?  // Form section name
  
  // Column Intelligence
  linkedColumn      String?  // Linked table column
  semanticType      String?  // email, phone, name, etc.
  sensitivity       String   @default("public") // public, pii, phi
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  form              Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  @@unique([formId, fieldName])
  @@index([formId])
  @@index([fieldType])
}

// ============================================================================
// API & CONTROLLER MODELS
// ============================================================================

/// Controller - API Controller definition
model Controller {
  id                String   @id @default(cuid())
  projectId         String
  
  // Module relation
  moduleId          String?
  
  // Controller Identity
  name              String
  controllerKey     String   @unique // e.g., "PatientController"
  
  // Source
  filePath          String?  // Original file path
  sourceType        String   @default("mvc") // mvc, api, webapi
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  endpoints         APIEndpoint[]
  
  @@index([projectId])
  @@index([moduleId])
  @@index([name])
}

/// API Endpoint - Individual API endpoint
model APIEndpoint {
  id                String   @id @default(cuid())
  controllerId      String
  
  // Endpoint Identity
  endpointKey       String   @unique
  methodName        String   // Action method name
  
  // HTTP Configuration
  httpMethod        String   @default("GET") // GET, POST, PUT, DELETE, PATCH
  route             String   // Route template
  routePrefix       String?  // Route prefix
  
  // Parameters
  parameters        String   @default("[]") // JSON: APIParameter[]
  requestBody       String?  // JSON: Request body schema
  responseBody      String?  // JSON: Response body schema
  
  // Response
  responseType      String?  // json, xml, view
  
  // Source
  sourceSP          String?  // Generated from stored procedure
  sourceTable       String?  // Related table
  
  // Authentication
  requiresAuth      Boolean  @default(true)
  requiredRoles     String   @default("[]") // JSON: string[]
  
  // Documentation
  summary           String?
  description       String?
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  controller        Controller        @relation(fields: [controllerId], references: [id], onDelete: Cascade)
  
  @@index([controllerId])
  @@index([httpMethod])
  @@index([sourceSP])
}

// ============================================================================
// WORKFLOW MODELS
// ============================================================================

/// Workflow - Business workflow definition
model Workflow {
  id                String   @id @default(cuid())
  projectId         String
  
  // Module relation
  moduleId          String?
  
  // Workflow Identity
  workflowKey       String   @unique
  name              String
  
  // Description
  description       String?
  businessContext   String?  // Business context
  
  // Configuration
  isSequential      Boolean  @default(true)
  allowParallel     Boolean  @default(false)
  
  // Status
  status            String   @default("draft") // draft, active, deprecated
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  states            WorkflowState[]
  transitions       WorkflowTransition[]
  
  @@index([projectId])
  @@index([moduleId])
  @@index([status])
}

/// Workflow State - States in a workflow
model WorkflowState {
  id                String   @id @default(cuid())
  workflowId        String
  
  // State Identity
  stateKey          String   // Unique key within workflow
  stateName         String
  
  // State Type
  isInitial         Boolean  @default(false)
  isFinal           Boolean  @default(false)
  isError           Boolean  @default(false)
  
  // Properties
  description       String?
  order             Int      @default(0)
  
  // Actions
  onEnter           String?  // JSON: Actions on enter
  onExit            String?  // JSON: Actions on exit
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromTransitions   WorkflowTransition[] @relation("FromState")
  toTransitions     WorkflowTransition[] @relation("ToState")
  
  @@unique([workflowId, stateKey])
  @@index([workflowId])
}

/// Workflow Transition - Transitions between states
model WorkflowTransition {
  id                String   @id @default(cuid())
  workflowId        String
  
  // Transition Identity
  transitionKey     String   // Unique key
  transitionName    String
  
  // From/To
  fromStateId       String
  toStateId         String
  
  // Trigger
  trigger           String?  // Event that triggers transition
  triggerType       String   @default("manual") // manual, automatic, event, timer
  
  // Conditions
  conditions        String   @default("[]") // JSON: TransitionCondition[]
  
  // Actions
  actions           String   @default("[]") // JSON: TransitionAction[]
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromState         WorkflowState     @relation("FromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState           WorkflowState     @relation("ToState", fields: [toStateId], references: [id], onDelete: Cascade)
  
  @@unique([workflowId, transitionKey])
  @@index([workflowId])
  @@index([fromStateId])
  @@index([toStateId])
}

