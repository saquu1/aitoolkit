// =============================================================================
// INTELLIGENCE BANK - Phase 2 Models
// =============================================================================

/// Stores information about code entities (components, API routes, pages, hooks, etc.)
model EntityRegistry {
  id            String   @id @default(cuid())
  entityType    String   // 'component', 'api_route', 'page', 'hook', 'lib', 'table', 'procedure'
  entityName    String
  filePath      String
  moduleName    String?  // Feature/module this belongs to
  description   String?
  
  // Metadata
  props         String   @default("[]")  // JSON array of props/parameters
  imports       String   @default("[]")  // JSON array of imports
  exports       String   @default("[]")  // JSON array of exports
  
  // Intelligence
  usageCount    Int      @default(0)     // How many times this entity is used
  lastUsedAt    DateTime?
  confidence    Float    @default(0.5)   // Confidence score 0-1
  
  // Priority scoring
  priority      String   @default("medium")  // 'critical', 'high', 'medium', 'low'
  impactScore   Int      @default(0)     // 0-100 impact score
  riskScore     Int      @default(0)     // 0-100 risk score
  
  // Status
  status        String   @default("active")  // 'active', 'deprecated', 'deleted'
  hasIssues     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  usages        EntityUsage[]
  relationships EntityRelationship[] @relation("EntityRelations")
  relatedTo     EntityRelationship[] @relation("RelatedEntities")
  fields        FieldRegistry[]
  
  @@unique([entityType, entityName, filePath])
  @@index([entityType])
  @@index([moduleName])
  @@index([priority])
  @@index([status])
}

/// Tracks where entities are used (dependency tracking)
model EntityUsage {
  id            String   @id @default(cuid())
  entityId      String
  usedInFile    String   // File that uses this entity
  usedInEntity  String?  // Entity that uses this entity
  usageType     String   // 'import', 'call', 'render', 'extends', 'reference'
  usageLine     Int?
  usageContext  String?  // Additional context about the usage
  
  // Intelligence
  isDirectUsage Boolean  @default(true)  // Direct vs indirect usage
  frequency     Int      @default(1)     // How many times used in this file
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  Entity        EntityRegistry @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  @@index([entityId])
  @@index([usedInFile])
  @@index([usageType])
}

/// Tracks relationships between entities (data flow, dependencies)
model EntityRelationship {
  id              String   @id @default(cuid())
  sourceEntityId  String
  targetEntityId  String
  relationshipType String  // 'calls', 'imports', 'extends', 'implements', 'uses', 'depends_on'
  
  // Data contract info
  dataMapping     String?  // JSON: mapping of fields exchanged
  contractValid   Boolean  @default(true)
  lastValidated   DateTime?
  
  // Priority for fixing issues
  priority        String   @default("medium")
  hasIssues       Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  sourceEntity    EntityRegistry @relation("EntityRelations", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity    EntityRegistry @relation("RelatedEntities", fields: [targetEntityId], references: [id], onDelete: Cascade)
  
  @@unique([sourceEntityId, targetEntityId, relationshipType])
  @@index([relationshipType])
  @@index([hasIssues])
}

/// Tracks fields/properties within entities
model FieldRegistry {
  id            String   @id @default(cuid())
  entityId      String
  fieldName     String
  fieldType     String   // 'string', 'number', 'boolean', 'object', 'array', 'unknown'
  isRequired    Boolean  @default(false)
  defaultValue  String?
  
  // Intelligence
  semanticType  String?  // 'email', 'phone', 'name', 'id', 'date', etc.
  isPII         Boolean  @default(false)
  isPHI         Boolean  @default(false)
  validation    String?  // JSON validation rules
  
  // Usage tracking
  usageCount    Int      @default(0)
  lastUsedAt    DateTime?
  
  // Naming variants detected
  namingVariants String  @default("[]")  // JSON: different names found (pattern_id, patternId, PatternID)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  Entity        EntityRegistry @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  @@unique([entityId, fieldName])
  @@index([fieldType])
  @@index([semanticType])
  @@index([isPII])
}

/// Priority scoring for issues and entities
model PriorityScore {
  id            String   @id @default(cuid())
  entityType    String   // 'issue', 'entity', 'field'
  entityId      String
  
  // Scoring factors (0-100 each)
  impactScore   Int      @default(0)    // User/business impact
  frequencyScore Int     @default(0)    // How often this is used
  riskScore     Int      @default(0)    // Risk of breaking
  effortScore   Int      @default(0)    // Effort to fix (inverse priority)
  
  // Calculated
  totalScore    Int      @default(0)    // Weighted total
  priority      String   @default("medium")  // 'critical', 'high', 'medium', 'low'
  
  // Context
  reason        String?  // Why this priority was assigned
  dependencies  String   @default("[]")  // JSON: entities affected
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([entityType, entityId])
  @@index([priority])
  @@index([totalScore])
}

/// Stores naming conventions and patterns detected
model NamingConvention {
  id            String   @id @default(cuid())
  entityType    String   // 'table', 'column', 'api_route', 'component', 'variable'
  pattern       String   // Detected pattern: 'snake_case', 'camelCase', 'PascalCase'
  example       String   // Example name
  frequency     Int      @default(1)  // How often this pattern appears
  
  // Recommendation
  isPreferred   Boolean  @default(false)
  suggestedFix  String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([entityType, pattern])
  @@index([entityType])
  @@index([isPreferred])
}

/// Stores detected data flow patterns
model DataFlowPattern {
  id            String   @id @default(cuid())
  sourceEntity  String   // Where data originates
  targetEntity  String   // Where data goes
  fieldMappings String   @default("[]")  // JSON: [{sourceField, targetField, transformation}]
  
  // Pattern info
  patternType   String   // 'direct', 'transformed', 'aggregated', 'split'
  frequency     Int      @default(1)
  
  // Intelligence
  confidence    Float    @default(0.5)
  hasIssues     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([sourceEntity, targetEntity])
  @@index([patternType])
}

// =============================================================================
// SMART FIXER - Phase 3 Models
// =============================================================================

/// Stores fix suggestions for contract issues
model FixSuggestion {
  id            String   @id @default(cuid())
  issueId       String   // Reference to ContractIssue
  
  // Fix details
  fixType       String   // 'rename_field', 'add_param', 'remove_param', 'add_null_check', 'change_type', 'create_endpoint'
  description   String
  codeChange    String   // JSON: { file, oldCode, newCode, lineStart, lineEnd }
  
  // Impact analysis
  affectedFiles String   @default("[]")  // JSON array of affected file paths
  affectedEntities String @default("[]") // JSON array of affected entity IDs
  impactScore   Int      @default(0)     // 0-100: how many things affected
  
  // Effort estimation
  effortLevel   String   @default("medium")  // 'trivial', 'easy', 'medium', 'hard', 'complex'
  estimatedTime Int      @default(0)     // Minutes estimated
  
  // Confidence
  confidence    Float    @default(0.5)   // 0-1: how confident in this fix
  autoSafe      Boolean  @default(false) // Is this safe to auto-apply?
  
  // Status
  status        String   @default("suggested")  // 'suggested', 'approved', 'applied', 'rejected', 'reverted'
  appliedAt     DateTime?
  appliedBy     String?
  
  // Alternative fixes
  alternatives  String   @default("[]")  // JSON array of alternative fix IDs
  preferredFix  Boolean  @default(false) // Is this the preferred fix?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([issueId])
  @@index([fixType])
  @@index([status])
}

/// Tracks fix history for rollback capability
model FixHistory {
  id            String   @id @default(cuid())
  scanId        String
  
  // What was changed
  issueId       String
  suggestionId  String
  filePath      String
  
  // Before/After
  originalContent String  // Original file content
  modifiedContent String  // Modified file content
  diff          String   // Unified diff
  
  // Backup location
  backupPath    String?  // Path to backup file
  
  // Status
  status        String   @default("applied")  // 'applied', 'reverted', 'failed'
  appliedAt     DateTime @default(now())
  revertedAt    DateTime?
  revertedBy    String?
  
  // Metadata
  appliedBy     String?
  notes         String?
  
  createdAt     DateTime @default(now())
  
  @@index([scanId])
  @@index([issueId])
  @@index([status])
}

/// Stores backup snapshots before fixes
model BackupSnapshot {
  id            String   @id @default(cuid())
  scanId        String
  
  // File info
  filePath      String
  fileName      String
  
  // Content
  content       String
  contentHash   String   // SHA-256 hash
  
  // Metadata
  fileSize      Int      @default(0)
  lineCount     Int      @default(0)
  
  // Location
  backupPath    String?  // Path in backup/history/SCAN-ID/
  
  // Status
  restored      Boolean  @default(false)
  restoredAt    DateTime?
  
  createdAt     DateTime @default(now())
  
  @@unique([scanId, filePath])
  @@index([scanId])
  @@index([filePath])
}

/// Stores fix patterns for learning
model FixPattern {
  id            String   @id @default(cuid())
  
  // Pattern identification
  issueType     String   // Type of issue this pattern fixes
  patternName   String
  description   String
  
  // Pattern details
  triggerCondition String  // JSON: conditions that trigger this pattern
  fixTemplate   String   // Template for the fix
  
  // Success metrics
  timesApplied  Int      @default(0)
  successRate   Float    @default(0.0)  // 0-1
  avgImpactScore Float   @default(0.0)
  
  // Learning
  lastUsedAt    DateTime?
  learnedFrom   String?  // Where this pattern was learned from
  
  // Status
  isActive      Boolean  @default(true)
  confidence    Float    @default(0.5)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([issueType, patternName])
  @@index([issueType])
  @@index([isActive])
}

/// Stores auto-apply rules
model AutoApplyRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  
  // Conditions
  issueTypes    String   @default("[]")  // JSON array of issue types to auto-fix
  severityMax   String   @default("warning")  // Max severity to auto-fix
  confidenceMin Float    @default(0.9)   // Minimum confidence required
  
  // Safety
  requireBackup Boolean  @default(true)
  requireTest   Boolean  @default(false) // Run tests after fix?
  maxFiles      Int      @default(5)     // Max files to modify at once
  
  // Scope
  filePatterns  String   @default("[]")  // JSON: glob patterns for files to include/exclude
  
  // Status
  isActive      Boolean  @default(true)
  lastAppliedAt DateTime?
  timesApplied  Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
}

// =============================================================================
// FLOW MAP & TEST GENERATOR - Phase 4 Models
// =============================================================================

/// Stores data flow information between entities
model DataFlow {
  id            String   @id @default(cuid())
  scanId        String
  
  // Source info
  sourceType    String   // 'frontend', 'api', 'database'
  sourceEntity  String   // Component name, API route, or table name
  sourceField   String?  // Field/property name
  
  // Target info
  targetType    String   // 'frontend', 'api', 'database'
  targetEntity  String
  targetField   String?
  
  // Flow details
  flowType      String   // 'request', 'response', 'query', 'mutation', 'render'
  dataType      String?  // 'string', 'number', 'object', 'array'
  
  // Transformation
  transformation String? // JSON: how data is transformed
  isValid       Boolean  @default(true)
  
  // Position for visualization
  positionX     Int      @default(0)
  positionY     Int      @default(0)
  
  createdAt     DateTime @default(now())
  
  @@unique([scanId, sourceEntity, sourceField, targetEntity, targetField])
  @@index([scanId])
  @@index([sourceType])
  @@index([targetType])
}

/// Stores flow nodes for visualization
model FlowNode {
  id            String   @id @default(cuid())
  scanId        String
  
  // Node info
  nodeType      String   // 'frontend_component', 'api_endpoint', 'database_table', 'hook', 'util'
  nodeName      String
  nodeLabel     String?
  description   String?
  
  // Visual properties
  positionX     Int      @default(0)
  positionY     Int      @default(0)
  width         Int      @default(150)
  height        Int      @default(80)
  color         String   @default("#3b82f6")
  icon          String?
  
  // Metadata
  filePath      String?
  lineStart     Int?
  lineEnd       Int?
  hasIssues     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  
  @@unique([scanId, nodeName])
  @@index([scanId])
  @@index([nodeType])
}

/// Stores generated test cases
model GeneratedTest {
  id            String   @id @default(cuid())
  scanId        String
  
  // Test info
  testName      String
  testType      String   // 'contract', 'integration', 'unit', 'e2e'
  description   String
  
  // What is being tested
  endpointPath  String?  // API endpoint
  componentName String? // Frontend component
  tableName     String? // Database table
  
  // Test code
  testCode      String   // Generated test code
  testFilePath  String   // Where to save the test
  
  // Test data
  inputData     String?  // JSON: test input data
  expectedOutput String? // JSON: expected output
  
  // Status
  status        String   @default("generated")  // 'generated', 'saved', 'passed', 'failed', 'skipped'
  lastRunAt     DateTime?
  lastResult    String?
  errorMessage  String?
  
  // Metrics
  runCount      Int      @default(0)
  passCount     Int      @default(0)
  failCount     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([scanId, testName])
  @@index([scanId])
  @@index([testType])
  @@index([status])
}

/// Stores test suites
model TestSuite {
  id            String   @id @default(cuid())
  scanId        String
  name          String
  description   String?
  
  // Suite config
  testFramework String   @default("vitest")  // 'vitest', 'jest', 'playwright'
  testType      String   @default("contract")
  
  // Status
  totalTests    Int      @default(0)
  passedTests   Int      @default(0)
  failedTests   Int      @default(0)
  skippedTests  Int      @default(0)
  
  lastRunAt     DateTime?
  duration      Int?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([scanId, name])
  @@index([scanId])
}

/// Stores test run history
model TestRun {
  id            String   @id @default(cuid())
  suiteId       String?
  scanId        String
  
  // Run info
  runType       String   // 'full', 'incremental', 'single'
  triggeredBy   String   @default("manual")  // 'manual', 'auto', 'ci'
  
  // Results
  totalTests    Int      @default(0)
  passedTests   Int      @default(0)
  failedTests   Int      @default(0)
  skippedTests  Int      @default(0)
  
  // Details
  duration      Int      @default(0)  // milliseconds
  coverage      Float?   // 0-100
  
  // Output
  output        String?  // Test output log
  errorMessage  String?
  
  // CI info
  ciBuildId     String?
  ciBranch      String?
  
  createdAt     DateTime @default(now())
  
  @@index([suiteId])
  @@index([scanId])
  @@index([createdAt])
}

/// Stores contract definitions
model ContractDefinition {
  id            String   @id @default(cuid())
  
  // Contract info
  contractType  String   // 'api', 'component', 'database'
  name          String
  version       String   @default("1.0.0")
  
  // Definition
  schema        String   // JSON Schema for the contract
  examples      String   @default("[]")  // JSON array of examples
  
  // Validation
  isValid       Boolean  @default(true)
  lastValidated DateTime?
  
  // Source
  sourceFile    String?
  autoGenerated Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([contractType, name])
  @@index([contractType])
}

// =============================================================================
// PRE-COMMIT HOOK & IMPORT SUGGESTIONS - Phase 5 Models
// =============================================================================

/// Stores pre-commit hook configuration
model PreCommitHook {
  id            String   @id @default(cuid())
  
  // Hook config
  name          String
  description   String?
  isActive      Boolean  @default(true)
  
  // Triggers
  runOnCommit   Boolean  @default(true)
  runOnPush     Boolean  @default(false)
  runOnPrePush  Boolean  @default(false)
  
  // What to check
  checkContracts Boolean @default(true)
  checkTypes    Boolean  @default(true)
  checkImports  Boolean  @default(true)
  
  // File patterns
  includePatterns String @default("[\"**/*.ts\",\"**/*.tsx\"]")
  excludePatterns String @default("[\"**/node_modules/**\",\"**/.next/**\"]")
  
  // Actions
  blockOnErrors Boolean  @default(true)
  blockOnWarnings Boolean @default(false)
  autoFix       Boolean  @default(false)
  
  // Statistics
  timesRun      Int      @default(0)
  timesBlocked  Int      @default(0)
  lastRunAt     DateTime?
  lastBlockedAt DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
}

/// Stores hook execution history
model HookExecution {
  id            String   @id @default(cuid())
  hookId        String
  
  // Execution info
  trigger       String   // 'commit', 'push', 'pre-push', 'manual'
  triggeredBy   String?  // User or 'auto'
  
  // Files checked
  filesChecked  Int      @default(0)
  issuesFound   Int      @default(0)
  errorsFound   Int      @default(0)
  warningsFound Int      @default(0)
  
  // Result
  passed        Boolean  @default(true)
  blocked       Boolean  @default(false)
  autoFixed     Boolean  @default(false)
  
  // Details
  output        String?
  errorMessage  String?
  duration      Int      @default(0)  // milliseconds
  
  // Git info
  gitBranch     String?
  gitCommit     String?
  
  createdAt     DateTime @default(now())
  
  @@index([hookId])
  @@index([createdAt])
  @@index([passed])
}

/// Stores import analysis results
model ImportAnalysis {
  id            String   @id @default(cuid())
  
  // File info
  filePath      String
  importStatement String
  
  // Analysis
  importType    String   // 'named', 'default', 'namespace', 'dynamic'
  source        String   // What's being imported
  sourcePath    String   // Path it's imported from
  
  // Status
  isValid       Boolean  @default(true)
  canBeFixed    Boolean  @default(false)
  
  // Suggestions
  suggestedFix  String?  // Suggested import fix
  confidence    Float    @default(0.5)
  
  // Usage
  isUsed        Boolean  @default(true)  // Is this import actually used?
  usageCount    Int      @default(0)
  
  // Position
  lineNumber    Int?
  columnNumber  Int?
  
  createdAt     DateTime @default(now())
  
  @@unique([filePath, importStatement])
  @@index([filePath])
  @@index([isValid])
  @@index([isUsed])
}

/// Stores import fix suggestions
model ImportSuggestion {
  id            String   @id @default(cuid())
  
  // Current import
  filePath      String
  currentImport String
  currentPath   String
  
  // Suggested fix
  suggestedImport String?
  suggestedPath   String
  reason          String   // 'typo', 'moved', 'renamed', 'wrong_path', 'unused'
  
  // Impact
  impactLevel   String   @default("low")  // 'low', 'medium', 'high'
  affectedFiles String   @default("[]")   // JSON array
  
  // Status
  status        String   @default("suggested")  // 'suggested', 'applied', 'dismissed'
  appliedAt     DateTime?
  dismissedAt   DateTime?
  dismissedBy   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([filePath, currentImport])
  @@index([status])
  @@index([reason])
}

/// Stores module resolution cache
model ModuleResolution {
  id            String   @id @default(cuid())
  
  // Module info
  moduleName    String
  modulePath    String
  moduleType    String   // 'local', 'npm', 'alias'
  
  // Resolution
  resolvedPath  String
  isTypeOnly    Boolean  @default(false)
  
  // Exports
  namedExports  String   @default("[]")  // JSON array
  defaultExport Boolean  @default(false)
  
  // Status
  exists        Boolean  @default(true)
  lastChecked   DateTime @default(now())
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([moduleName, modulePath])
  @@index([moduleType])
}

/// Stores pre-commit skip rules
model SkipRule {
  id            String   @id @default(cuid())
  
  // Rule info
  name          String
  description   String?
  isActive      Boolean  @default(true)
  
  // Conditions
  ruleType      String   // 'file_pattern', 'branch', 'author', 'commit_message'
  pattern       String   // Regex pattern
  
  // Scope
  skipAll       Boolean  @default(false)
  skipChecks    String   @default("[]")  // JSON array of check types to skip
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
  @@index([ruleType])
}
