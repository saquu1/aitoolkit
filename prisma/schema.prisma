generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER / AUTHENTICATION
// ============================================

model AppUser {
  id        Int      @id @default(autoincrement())
  loginName String   @unique @map("login_name")
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// ============================================
// COMPANY SETTINGS
// ============================================

model CompanyInfo {
  id                      Int     @id @default(1)
  companyName             String  @default("My Company") @map("company_name")
  address                 String? @map("address")
  phone                   String? @map("phone")
  email                   String? @map("email")
  website                 String? @map("website")
  ntn                     String? @map("ntn")
  stn                     String? @map("stn")
  logoPath                String? @map("logo_path")
  incomeAccountId         Int?    @map("income_account_id")
  // Voucher Titles & Footers
  expVoucherTitle         String? @map("exp_voucher_title") @default("EXPENSE VOUCHER")
  expVoucherFooter        String? @map("exp_voucher_footer")
  expVoucherSignature     String? @map("exp_voucher_signature")
  incVoucherTitle         String? @map("inc_voucher_title") @default("INCOME VOUCHER")
  incVoucherFooter        String? @map("inc_voucher_footer")
  incVoucherSignature     String? @map("inc_voucher_signature")
  fundsPaymentTitle       String? @map("funds_payment_title") @default("PAYMENT VOUCHER")
  fundsPaymentFooter      String? @map("funds_payment_footer")
  fundsReceiveTitle       String? @map("funds_receive_title") @default("RECEIPT VOUCHER")
  fundsReceiveFooter      String? @map("funds_receive_footer")
  journalTitle            String? @map("journal_title") @default("JOURNAL VOUCHER")
  journalFooter           String? @map("journal_footer")
  employeePaymentTitle    String? @map("employee_payment_title") @default("EMPLOYEE PAYMENT")
  employeePaymentFooter   String? @map("employee_payment_footer")
  supplierPaymentTitle    String? @map("supplier_payment_title") @default("SUPPLIER PAYMENT")
  supplierPaymentFooter   String? @map("supplier_payment_footer")
  // GST / Invoice settings
  gstEnabled              Boolean @default(false) @map("gst_enabled")
  defaultGstPercent       Float   @default(0) @map("default_gst_percent")
  gstSaleInvoiceTitle     String? @map("gst_sale_invoice_title") @default("GST SALE INVOICE")
  gstSaleInvoiceAddress   String? @map("gst_sale_invoice_address")
  gstSaleInvoiceFooter    String? @map("gst_sale_invoice_footer")
  gstQuoteTitle           String? @map("gst_quote_title") @default("GST QUOTATION")
  gstQuoteAddress         String? @map("gst_quote_address")
  gstQuoteFooter          String? @map("gst_quote_footer")
  gstQuoteTerms           String? @map("gst_quote_terms")
  gstSaleTerms            String? @map("gst_sale_terms")
  gstLastLine             String? @map("gst_last_line")
  saleNoStart             Int     @default(1) @map("sale_no_start")
  quoteNoStart            Int     @default(1) @map("quote_no_start")
  dcTitle                 String? @map("dc_title") @default("DELIVERY CHALLAN")
  dcLine                  String? @map("dc_line")
  dcFooter                String? @map("dc_footer")
  dcTerms                 String? @map("dc_terms")
  saleTerms               String? @map("sale_terms")
  saleFooter              String? @map("sale_footer")
  saleTitle               String? @map("sale_title") @default("SALE INVOICE")
  // Sale headers
  purchaseTitle           String? @map("purchase_title") @default("PURCHASE INVOICE")
}

// ============================================
// ACCOUNT TYPES (Chart of Accounts Headings)
// ============================================

model AccountHead {
  id          Int     @id @default(autoincrement())
  atype       String  @unique @map("atype") // BANK, EMPLOYEE, INCOME, EXPENSE, CUSTOMER, PAYABLE, RECEIVABLE, CAPITAL, ASSET, LIABILITY, STOCK
  dr          String  @map("dr") // "DR" or "CR" or "BL"
  description String? @map("description")
  sortOrder   Int     @default(0) @map("sort_order")
  accounts    Account[]

  @@map("account_heads")
}

// ============================================
// ACCOUNTS (Master Ledger Accounts)
// ============================================

model Account {
  id           Int      @id @default(autoincrement()) @map("account_id")
  aname        String   @map("aname")
  atype        String   @map("atype") // References AccountHead.atype
  isActive     Boolean  @default(true) @map("is_active")
  address      String?  @map("address")
  contactNo    String?  @map("contact_no")
  registerDate DateTime @default(now()) @map("register_date")
  openBalance  Float    @default(0) @map("open_balance")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  debitTrans       Trans[]  @relation("DebitAccount")
  creditTrans      Trans[]  @relation("CreditAccount")
  salaryAdjusts    SalaryAdjustment[]
  customerInstallments Installment[] @relation("CustomerInstallments")
  saleMasters      SaleMaster[] @relation("SaleCustomer")
  quoteMasters     QuoteMaster[] @relation("QuoteCustomer")
  creditMasters    CreditMaster[] @relation("CreditCustomer")
  deliveryChallans DeliveryChallan[] @relation("DCCustomer")
  head             AccountHead? @relation(fields: [atype], references: [atype])

  @@index([atype])
  @@map("accounts")
}

// ============================================
// TRANSACTIONS (Double-Entry Journal)
// ============================================

model Trans {
  id         Int      @id @default(autoincrement()) @map("trans_id")
  transDate  DateTime @map("trans_date")
  accountId  Int      @map("account_id")
  bankId     Int?     @map("bank_id")
  projectId  Int?     @map("project_id")
  debit      Float    @default(0) @map("debit")
  credit     Float    @default(0) @map("credit")
  refNo      String?  @map("ref_no")
  comments   String?  @map("comments")
  transType  String   @map("trans_type") // EXPENSE, INCOME, EMPLOYEE, JOURNAL, PAYMENT, RECEIPT, GEN_PAY, GEN_REC, OPEN_BALANCE, DUE, INSTALLMENT, COLLECTION
  isRemind   Boolean  @default(false) @map("is_remind")
  createdAt  DateTime @default(now()) @map("created_at")

  account     Account  @relation("CreditAccount", fields: [accountId], references: [id])
  bank        Account? @relation("DebitAccount", fields: [bankId], references: [id])
  project         Product? @relation(fields: [projectId], references: [id])
  installments    Installment[]
  purchaseEntries PurchaseDetail[] @relation("PurchaseEntries")

  @@index([transDate])
  @@index([transType])
  @@index([accountId])
  @@index([bankId])
  @@map("trans")
}

// ============================================
// PRODUCTS / PROJECTS
// ============================================

model Product {
  id         Int     @id @default(autoincrement()) @map("product_id")
  pname      String  @map("pname")
  pcode      String? @map("pcode") @default("") // Product code / SKU
  punit      String? @map("punit") @default("PCS")
  costPrice  Float   @default(0) @map("cost_price")
  salePrice  Float   @default(0) @map("sale_price")
  openQty    Float   @default(0) @map("open_qty") // Opening stock quantity
  reOrder    Float   @default(0) @map("re_order") // Re-order level
  isActive   Boolean @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  trans                  Trans[]
  saleDetails            SaleDetail[]
  purchaseProductDetails PurchaseDetail[] @relation("PurchaseProducts")
  quoteDetails           QuoteDetail[] @relation("QuoteDetailProduct")
  dcDetails              DCDetail[] @relation("DCProducts")

  @@map("products")
}

// ============================================
// SALARY ADJUSTMENTS
// ============================================

model SalaryAdjustment {
  id             Int     @id @default(autoincrement())
  empId          Int     @map("emp_id")
  month          String  // e.g., "2025-01"
  monthlyAmount  Float   @default(0) @map("monthly_amount")
  taxAmount      Float   @default(0) @map("tax_amount")
  leaveDays      Float   @default(0) @map("leave_days")
  otDays         Float   @default(0) @map("ot_days")
  additionAmt    Float   @default(0) @map("addition_amt")
  deductionAmt   Float   @default(0) @map("deduction_amt")
  paid           Float   @default(0) @map("paid")
  dueSalary      Float   @default(0) @map("due_salary")
  createdAt      DateTime @default(now()) @map("created_at")

  employee Account @relation(fields: [empId], references: [id])

  @@index([empId])
  @@map("salary_adjustments")
}

// ============================================
// INSTALLMENTS
// ============================================

model Installment {
  id              Int     @id @default(autoincrement()) @map("installment_id")
  transId         Int     @map("trans_id")
  customerId      Int     @map("customer_id")
  totalAmount     Float   @default(0) @map("total_amount")
  emiAmount       Float   @default(0) @map("emi_amount")
  totalEmis       Int     @default(0) @map("total_emis")
  paidEmis        Int     @default(0) @map("paid_emis")
  emiStartDate    DateTime @map("emi_start_date")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Trans  @relation(fields: [transId], references: [id])
  customer    Account @relation("CustomerInstallments", fields: [customerId], references: [id])

  @@index([customerId])
  @@map("installments")
}

// ============================================
// SALE DETAILS (linked to transactions)
// ============================================

model SaleDetail {
  id           Int    @id @default(autoincrement()) @map("sale_detail_id")
  saleId       Int    @map("sale_id") // References SaleMaster
  productId    Int    @map("product_id")
  qtyOut       Float  @default(0) @map("qty_out")
  salePrice    Float  @default(0) @map("sale_price")
  costPrice    Float  @default(0) @map("cost_price")
  totalAmount  Float  @default(0) @map("total_amount")
  lineGst      Float  @default(0) @map("line_gst")
  lineComments String? @map("line_comments")
  packNo       String? @map("pack_no")

  saleMaster SaleMaster @relation("SaleMasterDetails", fields: [saleId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])

  @@map("sale_details")
}

// ============================================
// PURCHASE DETAILS (linked to transactions)
// ============================================

model PurchaseDetail {
  id           Int     @id @default(autoincrement()) @map("purchase_detail_id")
  purchaseId   Int     @map("purchase_id") // trans_id of the purchase
  productId    Int     @map("product_id")
  purchaseDate DateTime @map("purchase_date")
  qtyIn        Float   @default(0) @map("qty_in")
  costPrice    Float   @default(0) @map("cost_price")
  totalAmount  Float   @default(0) @map("total_amount")

  purchase Trans @relation("PurchaseEntries", fields: [purchaseId], references: [id])
  product  Product @relation("PurchaseProducts", fields: [productId], references: [id])

  @@map("purchase_details")
}

// ============================================
// REPORTS CONFIGURATION
// ============================================

model Report {
  id         Int    @id @default(autoincrement()) @map("report_id")
  reportName String @unique @map("report_name")
  dispName   String @map("disp_name")
  reportType String @default("A") @map("report_type") // A = Accounting, F = Financial, P = Project, S = Special
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// ============================================
// SALE MASTER (Sales & Cash Sales header)
// ============================================

model SaleMaster {
  id               Int      @id @default(autoincrement()) @map("sale_id")
  saleNo           String   @map("sale_no") // Invoice number e.g. "SALE-001"
  saleDate         DateTime @map("sale_date")
  accountId        Int      @map("account_id") // Customer account (for credit sales) or cash/bank
  transType        String   @map("trans_type") // "SALE" (credit) or "CASH-SALE"
  customerName     String?  @map("customer_name")
  contactNo        String?  @map("contact_no")
  idCard           String?  @map("id_card")
  grossTotal       Float    @default(0) @map("gross_total") // Sub total before discount
  discountAllow    Float    @default(0) @map("discount_allow") // Discount given
  gst              Float    @default(0) @map("gst") // GST %
  gstAmount        Float    @default(0) @map("gst_amount") // Calculated GST amount
  grandTotal       Float    @default(0) @map("grand_total") // Final total
  totalCost        Float    @default(0) @map("total_cost") // Cost value for profit calc
  incomeTax        Float    @default(0) @map("income_tax") // Income tax %
  isPaid           Boolean  @default(false) @map("is_paid") // Fully paid?
  comments         String?  @map("comments")
  poRefNo          String?  @map("po_ref_no") // Purchase order reference
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  account      Account      @relation("SaleCustomer", fields: [accountId], references: [id])
  saleDetails  SaleDetail[] @relation("SaleMasterDetails")
  creditMasters CreditMaster[] @relation("CreditSale")

  @@index([saleDate])
  @@index([transType])
  @@index([accountId])
  @@index([isPaid])
  @@map("sale_master")
}

// ============================================
// QUOTE MASTER (Quotations)
// ============================================

model QuoteMaster {
  id              Int      @id @default(autoincrement()) @map("quote_id")
  quoteNo         String   @map("quote_no") // e.g. "QUO-001"
  quoteDate       DateTime @map("quote_date")
  accountId       Int      @map("account_id") // Customer
  customerName    String?  @map("customer_name")
  contactNo       String?  @map("contact_no")
  grossTotal      Float    @default(0) @map("gross_total")
  discountAllow   Float    @default(0) @map("discount_allow")
  gst             Float    @default(0) @map("gst")
  gstAmount       Float    @default(0) @map("gst_amount")
  grandTotal      Float    @default(0) @map("grand_total")
  comments        String?  @map("comments")
  convertedSaleId Int?     @map("converted_sale_id") // If converted to sale
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account     Account      @relation("QuoteCustomer", fields: [accountId], references: [id])
  quoteDetails QuoteDetail[] @relation("QuoteMasterDetails")

  @@index([quoteDate])
  @@index([accountId])
  @@map("quote_master")
}

// ============================================
// QUOTE DETAILS
// ============================================

model QuoteDetail {
  id          Int    @id @default(autoincrement()) @map("quote_detail_id")
  quoteId     Int    @map("quote_id")
  productId   Int    @map("product_id")
  qty         Float  @default(0) @map("qty")
  price       Float  @default(0) @map("price") // Sale price
  totalAmount Float  @default(0) @map("total_amount")
 lineGst     Float  @default(0) @map("line_gst") // GST amount for this line
  lineComments String? @map("line_comments")
  packNo      String? @map("pack_no")

  quote   QuoteMaster @relation("QuoteMasterDetails", fields: [quoteId], references: [id], onDelete: Cascade)
  product Product     @relation("QuoteDetailProduct", fields: [productId], references: [id])

  @@map("quote_details")
}

// ============================================
// CREDIT MASTER (Receivables / Credit Management)
// ============================================

model CreditMaster {
  id            Int      @id @default(autoincrement()) @map("credit_id")
  saleId        Int      @map("sale_id") // Reference to SaleMaster
  accountId     Int      @map("account_id") // Customer account
  invNo         String?  @map("inv_no") // Invoice number
  credit        Float    @default(0) @map("credit") // Total credit amount
  dueDate       DateTime @map("due_date")
  amt1          Float    @default(0) @map("amt1") // Paid amount 1
  amt2          Float    @default(0) @map("amt2") // Paid amount 2
  otherCharges  Float    @default(0) @map("other_charges")
  discount      Float    @default(0) @map("discount")
  balance       Float    @default(0) @map("balance") // Remaining balance
  isPaid        Boolean  @default(false) @map("is_paid")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sale    SaleMaster @relation("CreditSale", fields: [saleId], references: [id])
  account Account    @relation("CreditCustomer", fields: [accountId], references: [id])

  @@index([accountId])
  @@index([isPaid])
  @@index([dueDate])
  @@map("credit_master")
}

// ============================================
// DELIVERY CHALLAN
// ============================================

model DeliveryChallan {
  id            Int      @id @default(autoincrement()) @map("dc_id")
  dcNo          String   @map("dc_no") // e.g. "DC-001"
  dcDate        DateTime @map("dc_date")
  saleId        Int?     @map("sale_id") // Optional link to sale
  accountId     Int      @map("account_id") // Customer
  customerName  String?  @map("customer_name")
  contactNo     String?  @map("contact_no")
  address       String?  @map("address")
  comments      String?  @map("comments")
  isDelivered   Boolean  @default(false) @map("is_delivered")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account    Account?    @relation("DCCustomer", fields: [accountId], references: [id])
  dcDetails  DCDetail[]

  @@index([dcDate])
  @@index([accountId])
  @@map("delivery_challans")
}

// ============================================
// DELIVERY CHALLAN DETAILS
// ============================================

model DCDetail {
  id          Int    @id @default(autoincrement()) @map("dc_detail_id")
  dcId        Int    @map("dc_id")
  productId   Int    @map("product_id")
  qty         Float  @default(0) @map("qty")
  lineComments String? @map("line_comments")

  dc      DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)
  product Product         @relation("DCProducts", fields: [productId], references: [id])

  @@map("dc_details")
}
