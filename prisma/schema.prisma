  @@index([messageType])
  @@index([timestamp])
}

// ============================================================================
// SPDLL INTELLIGENCE MODELS (GAP-SP-006)
// ============================================================================

/// SP Intelligence - Main stored procedure analysis storage
model SPIntelligence {
  id                    String   @id @default(cuid())
  projectId             String
  procedureName         String
  originalDDL           String   // Full SP text
  schemaName            String   @default("dbo")

  // Classification
  actionType            String   @default("unknown") // create, read, update, delete, dropdown, search, report, validate, process, upsert, soft_delete, restore, bulk_operation, workflow_action, calculation, code_generation, export, import, sync, audit, notification, interface, authentication, configuration, print, unknown
  classificationMethod  String   @default("pattern_match") // pattern_match, body_analysis, ai_inference, manual
  classificationConfidence Float @default(0.0)

  // Parameter Intelligence
  inputParameters       String   @default("[]")  // JSON: SPParameter[]
  outputParameters      String   @default("[]")  // JSON: SPParameter[]
  systemParameters      String   @default("[]")  // UserId, OrgId etc.
  optionalParameters    String   @default("[]")

  // Body Intelligence
  businessRules         String   @default("[]")  // JSON: Extracted rules
  errorCodes            String   @default("[]")  // JSON: Error code mappings
  tableAccess           String   @default("[]")  // JSON: Tables read/written
  subProcedureCalls     String   @default("[]")  // JSON: Called SPs
  sideEffects           String   @default("[]")  // JSON: Audit, notification etc.

  // Transaction Intelligence
  hasTransaction        Boolean  @default(false)
  hasTryCatch           Boolean  @default(false)
  hasErrorHandling      Boolean  @default(false)
  hasDynamicSQL         Boolean  @default(false)
  hasTempTables         Boolean  @default(false)
  hasCursor             Boolean  @default(false)

  // Complexity Metrics
  lineCount             Int      @default(0)
  parameterCount        Int      @default(0)
  businessRuleCount     Int      @default(0)
  tableAccessCount      Int      @default(0)
  nestingDepth          Int      @default(0)
  cyclomaticComplexity  Int      @default(0)
  migrationRisk         String   @default("medium") // low, medium, high, critical

  // API Generation
  suggestedHttpMethod   String?  // GET, POST, PUT, DELETE, PATCH
  suggestedRoute        String?
  suggestedModule       String?
  generatedApiCode      String?  // Generated route.ts content
  generatedTypes        String?  // Generated TypeScript types
  generatedValidation   String?  // Generated Zod schema

  // Correlation
  correlatedViews       String   @default("[]")  // JSON: Matched CSHTML views
  correlatedTables      String   @default("[]")  // JSON: Schema tables
  correlatedControllers String   @default("[]")  // JSON: DLL controllers

  // Metadata
  isAnalyzed            Boolean  @default(false)
  isCorrelated          Boolean  @default(false)
  isGenerated           Boolean  @default(false)
  needsManualReview     Boolean  @default(false)
  reviewNotes           String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, procedureName])
  @@index([projectId])
  @@index([actionType])
  @@index([procedureName])
  @@index([migrationRisk])
}



/// DLL Intelligence - DLL decompilation results
model DLLIntelligence {
  id                    String   @id @default(cuid())
  projectId             String
  dllName               String
  dllVersion            String?

  // Controller Intelligence
  controllers           String   @default("[]")  // JSON: ControllerInfo[]
  controllerActions     String   @default("[]")  // JSON: ActionInfo[]
  routeMappings         String   @default("[]")  // JSON: RouteMapping[]
  authorizationRules    String   @default("[]")  // JSON: AuthRule[]

  // Model Intelligence
  modelClasses          String   @default("[]")  // JSON: ModelClass[]
  dtoClasses           String   @default("[]")  // JSON: DTOClass[]
  viewModels            String   @default("[]")  // JSON: ViewModel[]
  enumerations          String   @default("[]")  // JSON: EnumDefinition[]

  // Service Intelligence
  serviceClasses        String   @default("[]")  // JSON: ServiceClass[]
  repositoryClasses     String   @default("[]")  // JSON: RepositoryClass[]
  helperClasses         String   @default("[]")  // JSON: HelperClass[]

  // Dependency Intelligence
  nugetPackages         String   @default("[]")  // JSON: NuGetPackage[]
  projectReferences     String   @default("[]")  // JSON: string[]
  namespaces            String   @default("[]")  // JSON: string[]

  // Analysis Status
  isDecompiled          Boolean  @default(false)
  isAnalyzed            Boolean  @default(false)
  analysisMethod        String?  // decompiled, source_code, inferred

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, dllName])
  @@index([projectId])
  @@index([dllName])
}

/// API Generation Result - Generated API artifacts
model APIGenerationResult {
  id                    String   @id @default(cuid())
  projectId             String
  moduleName            String
  entityName            String

  // Source intelligence
  sourceSPs             String   @default("[]")  // JSON: string[]
  sourceTables          String   @default("[]")  // JSON: string[]

  // Generated artifacts
  routeFilePath         String
  routeFileContent      String   // Generated route.ts
  typeFilePath          String?
  typeFileContent       String?  // Generated types.ts
  validationFilePath    String?
  validationContent     String?  // Generated schema.ts (Zod)
  testFilePath          String?
  testFileContent       String?  // Generated test file

  // Generation quality
  generationConfidence  Float    @default(0.0)
  compilable            Boolean  @default(false)
  hasTypeErrors         Boolean  @default(false)
  warningCount          Int      @default(0)
  errorCount            Int      @default(0)
  validationLog         String   @default("[]")  // JSON: ValidationLog[]

  // Status
  status                String   @default("generated") // generated, reviewed, approved, deployed
  reviewedBy            String?
  reviewedAt            DateTime?
  approvedBy            String?
  approvedAt            DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, moduleName, entityName])
  @@index([projectId])
  @@index([moduleName])
  @@index([entityName])
  @@index([status])
}

/// Migration Mapping - Legacy to modern entity mappings
model MigrationMapping {
  id                    String   @id @default(cuid())
  projectId             String

  // Legacy entity
  legacyType            String   // sp, controller_action, view, table, dll_method
  legacyName            String
  legacyPath            String?
  legacySignature       String?

  // Modern entity
  modernType            String   // api_route, react_component, prisma_model, middleware
  modernName            String
  modernPath            String?
  modernSignature       String?

  // Mapping quality
  mappingMethod         String   @default("auto") // auto, manual, ai_assisted
  confidence            Float    @default(0.0)
  isComplete            Boolean  @default(false)
  isVerified            Boolean  @default(false)

  // Migration status
  status                String   @default("mapped") // mapped, in_progress, migrated, verified
  migrationNotes        String?
  blockers              String   @default("[]")  // JSON: string[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, legacyType, legacyName])
  @@index([projectId])
  @@index([legacyType, legacyName])
  @@index([modernType, modernName])
  @@index([status])
}

/// CSHTML AJAX Endpoint - Parsed AJAX endpoints from CSHTML
model CSHTMLAjaxEndpoint {
  id                    String   @id @default(cuid())
  projectId             String
  cshtmlViewName        String

  // Endpoint info
  endpointUrl           String
  httpMethod            String   @default("GET")
  dataType              String?  // json, html, xml

  // Parameters
  parameters            String   @default("[]")  // JSON: EndpointParam[]

  // Callbacks
  successCallback       String?
  errorCallback         String?

  // Context
  lineNumber            Int?
  context               String?  // Surrounding code context

  // Correlation
  linkedSP              String?  // Linked stored procedure
  linkedController      String?  // Linked controller
  linkedAction          String?  // Linked action method
  correlationConfidence Float    @default(0.0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, cshtmlViewName, endpointUrl])
  @@index([projectId])
  @@index([cshtmlViewName])
  @@index([linkedSP])
}

/// Error Code Mapping - CSHTML error codes to SP business rules
model ErrorCodeMapping {
  id                    String   @id @default(cuid())
  projectId             String

  // Source
  spName                String
  errorCode             Int

  // Error info from SP
  spErrorMessage        String?
  spCondition           String?

  // CSHTML handling
  cshtmlViewName        String?
  cshtmlErrorHandler    String?
  cshtmlUserMessage     String?

  // Alignment
  messageAlignment      String   @default("unknown") // aligned, different, missing_ui, missing_sp

  // Migration
  migratedErrorHandling String?  // Path to migrated error handler

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, spName, errorCode])
  @@index([projectId])
  @@index([spName])
}

/// Dropdown Mapping - CSHTML dropdowns to SP_DDL_* correlation
model DropdownMapping {
  id                    String   @id @default(cuid())
  projectId             String

  // CSHTML Source
  cshtmlViewName        String
  dropdownId            String?  // HTML element ID
  dropdownName          String?  // Form field name
  ddlMethod             String?  // DDLManager.GetXxxDDL()

  // SP Target
  linkedSP              String?  // SP_DDL_Xxx
  linkedTable           String?  // Lookup table
  valueColumn           String?  // Usually Id
  textColumn            String?  // Usually Name

  // Cascading
  parentDropdownId      String?
  cascadeParameter      String?  // @ParentId parameter

  // Correlation
  confidence            Float    @default(0.0)
  isVerified            Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, cshtmlViewName, dropdownName])
  @@index([projectId])
  @@index([linkedSP])
  @@index([linkedTable])
}

// ============================================================================
// PHASE 2: QUALITY & INTELLIGENCE MODELS
// ============================================================================

/// Confidence Score - Tracks confidence levels of extracted entities
model ConfidenceScore {
  id              String   @id @default(cuid())
  projectId       String?
  entityType      String   // 'table', 'column', 'fk', 'sp', 'view', 'module'
  entityId        String
  score           Float    // 0.0 to 1.0
  confidence      String   // 'high', 'medium', 'low', 'unverified'
  factors         String   @default("[]") // JSON array of scoring factors
  source          String   @default("inference") // 'direct_parse', 'inference', 'ai_generated'
  verifiedAt      DateTime?
  verifiedBy      String?  // 'agent' | 'user:userId' | 'ai'
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([projectId])
  @@index([score])
  @@index([confidence])
  @@index([entityType])
}

/// Scoring Factor - Defines weights for confidence scoring
model ScoringFactor {
  id              String   @id @default(cuid())
  name            String   @unique
  weight          Float    @default(0.15) // 0.0 to 1.0
  description     String?
  category        String   @default("default") // 'default', 'custom'
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([active])
}

/// Extraction Conflict - Tracks conflicts between different extraction sources
model ExtractionConflict {
  id              String   @id @default(cuid())
  projectId       String?
  entityType      String   // 'column', 'table', 'fk', 'sp', 'view'
  entityId        String
  conflictType    String   // 'type_mismatch', 'constraint_conflict', 'naming', 'value_conflict'
  severity        String   @default("medium") // 'critical', 'high', 'medium', 'low'
  
  // Source 1
  source1Agent    String   // Agent/parser that provided source 1
  source1Value    String   @default("{}") // JSON value
  source1Confidence Float  @default(0.5)
  source1File     String?  // Source file name
  
  // Source 2
  source2Agent    String   // Agent/parser that provided source 2
  source2Value    String   @default("{}") // JSON value
  source2Confidence Float  @default(0.5)
  source2File     String?  // Source file name
  
  // Resolution
  status          String   @default("pending") // 'pending', 'auto_resolvable', 'resolved', 'dismissed'
  resolution      String?  // 'source1', 'source2', 'merged', 'custom'
  resolvedValue   String?  @default("{}") // JSON
  resolvedBy      String?  // User ID or 'auto_resolver'
  resolvedAt      DateTime?
  resolutionNotes String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId, conflictType])
  @@index([projectId])
  @@index([status, severity])
  @@index([conflictType])
  @@index([entityType])
}

/// Conflict Rule - Auto-resolution rules for conflicts
model ConflictRule {
  id              String   @id @default(cuid())
  name            String
  conflictType    String   // Type of conflict this rule applies to
  priority        Int      @default(10) // Lower = higher priority
  resolution      String   // 'source1', 'source2', 'merged', 'custom'
  resolutionLogic String?  // JSON: Custom resolution logic
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name])
  @@index([conflictType])
  @@index([active])
  @@index([priority])
}

/// Project Version - Version tracking for comparison
model ProjectVersion {
  id              String   @id @default(cuid())
  projectId       String
  version         Int      @default(1)
  name            String?  // e.g., "v1.0.0", "Before Refactor"
  description     String?
  snapshot        String   // JSON: Full state snapshot
  changeSummary   String   @default("{}") // JSON: Summary of changes
  changeCount     Int      @default(0)
  tablesAdded     Int      @default(0)
  tablesRemoved   Int      @default(0)
  tablesModified  Int      @default(0)
  spsAdded        Int      @default(0)
  spsRemoved      Int      @default(0)
  spsModified     Int      @default(0)
  createdBy       String?  // User ID
  isAutoSave      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
  @@index([createdAt])
  @@index([createdBy])
}

/// Parse Cache - Caches parsed results for incremental parsing
model ParseCache {
  id              String   @id @default(cuid())
  projectId       String
  fileType        String   // 'sql', 'cshtml', 'cs', 'json', 'xml'
  filePath        String
  contentHash     String   // Hash of file content
  parseResult     String   // JSON: Parsed result
  parseVersion    String   @default("1.0.0")
  parseDuration   Int      @default(0) // milliseconds
  entityCount     Int      @default(0)
  isValid         Boolean  @default(true)
  errorMessage    String?
  parsedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, filePath])
  @@index([projectId])
  @@index([contentHash])
  @@index([fileType])
  @@index([isValid])
}

/// Verification Item - Items needing user verification
model VerificationItem {
  id              String   @id @default(cuid())
  projectId       String?
  itemType        String   // 'column', 'fk', 'sp', 'view', 'module', 'rule'
  itemId          String   // Entity ID
  itemName        String   // Human-readable name
  itemData        String   @default("{}") // JSON: Item data for review
  confidence      Float    @default(0.5)
  priority        String   @default("medium") // 'critical', 'high', 'medium', 'low'
  category        String   @default("general") // 'type_inference', 'fk_resolution', 'naming', 'business_logic'
  suggestedValue  String?  @default("{}") // JSON: Suggested value
  reason          String?  // Why verification needed
  status          String   @default("pending") // 'pending', 'approved', 'rejected', 'deferred'
  reviewedBy      String?  // User ID
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([itemType, itemId])
  @@index([projectId])
  @@index([status, priority])
  @@index([itemType])
  @@index([category])
}

/// Data Lineage - Tracks source of extracted data
model DataLineage {
  id              String   @id @default(cuid())
  projectId       String?
  entityType      String   // 'table', 'column', 'fk', 'sp', 'view'
  entityId        String
  entityName      String
  
  // Source tracking
  sourceType      String   // 'ddl', 'sp_body', 'view_body', 'cshtml', 'inference', 'ai_generated'
  sourceAgent     String?  // Agent that created this
  sourceFileId    String?  // Source file reference
  sourceFileName  String?  // Source file name
  sourceLineStart Int?
  sourceLineEnd   Int?
  sourceCharStart Int?
  sourceCharEnd   Int?
  
  // Extraction details
  extractionMethod String  @default("direct_parse") // 'direct_parse', 'inference', 'ai_generated', 'merged'
  extractionConfidence Float @default(1.0)
  extractionTime  Int      @default(0) // milliseconds
  
  // Dependencies
  dependsOn       String   @default("[]") // JSON: Array of entity IDs this depends on
  dependedBy      String   @default("[]") // JSON: Array of entity IDs that depend on this
  
  // Timestamps
  extractedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([projectId])
  @@index([entityType])
  @@index([sourceType])
  @@index([sourceAgent])
}

/// Incremental Change - Tracks changes for incremental parsing
model IncrementalChange {
  id              String   @id @default(cuid())
  projectId       String
  versionFrom     Int
  versionTo       Int
  changeType      String   // 'add', 'modify', 'delete'
  entityType      String   // 'table', 'column', 'fk', 'sp', 'view'
  entityId        String
  entityName      String
  oldValue        String?  @default("{}") // JSON
  newValue        String?  @default("{}") // JSON
  impactScore     Int      @default(0) // 0-100
  affectedEntities String  @default("[]") // JSON: Array of affected entity IDs
  createdAt       DateTime @default(now())

  @@unique([projectId, versionFrom, versionTo, entityType, entityId])
  @@index([projectId])
  @@index([versionFrom])
  @@index([versionTo])
  @@index([changeType])
  @@index([entityType])
}

/// Quality Metrics - Aggregated quality metrics for projects
model QualityMetrics {
  id              String   @id @default(cuid())
  projectId       String   @unique
  projectIdStr    String?  // For non-cuid project IDs
  
  // Confidence metrics
  avgConfidence   Float    @default(0)
  highConfidence  Int      @default(0)
  mediumConfidence Int     @default(0)
  lowConfidence   Int      @default(0)
  unverified      Int      @default(0)
  
  // Conflict metrics
  totalConflicts  Int      @default(0)
  resolvedConflicts Int    @default(0)
  pendingConflicts Int     @default(0)
  criticalConflicts Int    @default(0)
  
  // Verification metrics
  pendingVerifications Int @default(0)
  approvedVerifications Int @default(0)
  rejectedVerifications Int @default(0)
  
  // Entity counts
  totalTables     Int      @default(0)
  totalColumns    Int      @default(0)
  totalFKs        Int      @default(0)
  totalSPs        Int      @default(0)
  totalViews      Int      @default(0)
  
  // Coverage metrics
  moduleCoverage  Float    @default(0) // 0-100
  fkResolution    Float    @default(0) // 0-100
  piiDetection    Float    @default(0) // 0-100
  
  // Quality score (composite)
  qualityScore    Float    @default(0) // 0-100
  
  // Timestamps
  calculatedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([qualityScore])
  @@index([calculatedAt])
}

// ============================================================================
// PHASE 3: KNOWLEDGE GRAPH MODELS
// ============================================================================

/// Knowledge Graph Node - Represents an entity in the knowledge graph
model KGNode {
  id              String   @id @default(cuid())
  projectId       String
  
  // Node Identity
  nodeType        String   // 'table', 'view', 'sp', 'module', 'form', 'api', 'column'
  nodeSubtype     String?  // 'master', 'transaction', 'lookup', 'reference'
  name            String
  displayName     String?
  description     String?
  
  // Visual Properties
  positionX       Float?
  positionY       Float?
  color           String?
  size            Float    @default(1.0)
  icon            String?
  
  // Metadata
  properties      String   @default("{}") // JSON: Additional properties
  confidence      Float    @default(1.0)
  source          String?  // Agent that created this node
  
  // Status
  isActive        Boolean  @default(true)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  outgoingEdges   KGEdge[] @relation("OutgoingEdges")
  incomingEdges   KGEdge[] @relation("IncomingEdges")
  
  @@unique([projectId, nodeType, name])
  @@index([projectId])
  @@index([nodeType])
  @@index([name])
  @@index([source])
}

/// Knowledge Graph Edge - Represents relationships between nodes
model KGEdge {
  id              String   @id @default(cuid())
  projectId       String
  
  // Edge Endpoints
  sourceNodeId    String
  targetNodeId    String
  
  // Edge Type
  edgeType        String   // 'fk', 'sp_access', 'view_access', 'module_contains', 'api_call', 'column_of', 'references'
  label           String?  // Edge label for display
  
  // Metadata
  properties      String   @default("{}") // JSON: Additional edge properties
  confidence      Float    @default(1.0)
  weight          Float    @default(1.0)
  source          String?  // Agent that created this edge
  
  // Status
  isActive        Boolean  @default(true)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  sourceNode      KGNode   @relation("OutgoingEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      KGNode   @relation("IncomingEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, sourceNodeId, targetNodeId, edgeType])
  @@index([projectId])
  @@index([edgeType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// ============================================================================
// PHASE 3: VECTOR STORAGE MODELS
// ============================================================================

/// Code Embedding - Stores vector embeddings for semantic search
model CodeEmbedding {
  id              String   @id @default(cuid())
  projectId       String
  
  // Entity Reference
  entityType      String   // 'table', 'column', 'sp', 'view', 'module', 'form'
  entityId        String
  
  // Embedding Data
  content         String   // Text that was embedded
  embedding       String?  // JSON array of vector values (for SQLite compatibility)
  embeddingModel  String?  // Model used for embedding
  
  // Metadata
  tokenCount      Int      @default(0)
  contentHash     String?  // Hash of content for cache validation
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([projectId, entityType, entityId])
  @@index([projectId])
  @@index([entityType])
  @@index([entityId])
}

// ============================================================================
// PHASE 3: AGENT ORCHESTRATOR MODELS
// ============================================================================

/// Pipeline Run - Represents a single execution run of the agent orchestrator
model PipelineRun {
  id              String   @id @default(cuid())
  projectId       String?
  
  // Run Identity
  runId           String   @unique
  runName         String?
  
  // Configuration
  config          String   @default("{}") // JSON: Run configuration
  triggerSource   String   @default("manual") // 'manual', 'webhook', 'scheduled', 'api'
  
  // Execution State
  status          String   @default("idle") // 'idle', 'running', 'completed', 'failed', 'cancelled'
  startTime       DateTime @default(now())
  endTime         DateTime?
  duration        Int?     // milliseconds
  
  // Progress
  totalAgents     Int      @default(0)
  completedAgents Int      @default(0)
  failedAgents    Int      @default(0)
  skippedAgents   Int      @default(0)
  
  // Results
  output          String?  // JSON: Final output
  errors          String   @default("[]") // JSON: Array of errors
  
  // Metrics
  itemsProcessed  Int      @default(0)
  itemsProduced   Int      @default(0)
  
  // Relations
  executions      PipelineRunExecution[]
  logs            PipelineRunLog[]
  
  @@index([projectId])
  @@index([status])
  @@index([startTime])
}

/// Pipeline Run Execution - Individual agent execution within a pipeline run
model PipelineRunExecution {
  id              String   @id @default(cuid())
  runId           String
  
  // Agent Identity
  agentId         String
  agentName       String
  agentVersion    String   @default("1.0.0")
  
  // Execution State
  status          String   @default("pending") // 'pending', 'running', 'completed', 'failed', 'skipped'
  startTime       DateTime @default(now())
  endTime         DateTime?
  duration        Int?     // milliseconds
  
  // Input/Output
  input           String?  // JSON: Input data
  output          String?  // JSON: Output data
  
  // Results
  itemsProcessed  Int      @default(0)
  itemsProduced   Int      @default(0)
  retryCount      Int      @default(0)
  
  // Errors
  error           String?
  warnings        String   @default("[]") // JSON: Array of warnings
  
  // Relations
  run             PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  
  @@unique([runId, agentId])
  @@index([runId])
  @@index([agentId])
  @@index([status])
}

/// Pipeline Run Log - Log entries for agent execution
model PipelineRunLog {
  id              String   @id @default(cuid())
  runId           String
  
  // Log Entry
  timestamp       DateTime @default(now())
  level           String   @default("info") // 'debug', 'info', 'warn', 'error'
  agentId         String?
  message         String
  data            String?  // JSON: Additional data
  
  // Relations
  run             PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  
  @@index([runId])
  @@index([timestamp])
  @@index([level])
  @@index([agentId])
}

// ============================================================================
// PHASE 3: SEARCH INDEX MODELS
// ============================================================================

/// Search Index - Stores indexed content for full-text search
model SearchIndex {
  id              String   @id @default(cuid())
  projectId       String
  
  // Entity Reference
  entityType      String   // 'table', 'column', 'sp', 'view', 'module', 'form'
  entityId        String
  
  // Search Content
  title           String
  content         String   // Searchable content
  keywords        String   @default("[]") // JSON: Array of keywords
  tags            String   @default("[]") // JSON: Array of tags
  
  // Metadata
  relevanceScore  Float    @default(1.0)
  source          String?
  
  // Timestamps
  indexedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([projectId, entityType, entityId])
  @@index([projectId])
  @@index([entityType])
}

// ============================================================================
// UNIFIED INTELLIGENCE DATA BANK - Part 1 Enhancement
// ============================================================================

/// Unified Field - Master record for every field/column in the system
model UnifiedField {
  id                    String   @id @default(cuid())
  projectId             String
  tableId               String?
  tableName             String
  fieldName             String
  qualifiedName         String   // "Organization.CountryId"
  displayOrder          Int      @default(0)

  // Schema Layer
  schemaDataType        String?
  schemaBaseType        String?
  schemaMaxLength       Int?
  schemaPrecision       Int?
  schemaScale           Int?
  schemaIsNullable      Boolean  @default(true)
  schemaIsPrimaryKey    Boolean  @default(false)
  schemaIsIdentity      Boolean  @default(false)
  schemaIsComputed      Boolean  @default(false)
  schemaDefaultValue    String?
  schemaCheckConstraint String?
  schemaSource          String   @default("unknown")
  schemaConfidence      Float    @default(0.0)

  // FK Layer
  fkIsForeignKey        Boolean  @default(false)
  fkReferencedTable     String?
  fkReferencedColumn    String?
  fkTableExists         Boolean  @default(false)
  fkRelationshipType    String?
  fkOnDelete            String?
  fkOnUpdate            String?
  fkResolutionStatus    String   @default("not_fk")
  fkCascadeChain        String   @default("[]")
  fkSources             String   @default("{}")
  fkConfidence          Float    @default(0.0)

  // Intelligence Layer
  intelSemanticType     String?
  intelSemanticCategory String?
  intelBusinessMeaning  String?
  intelDataPattern      String?
  intelExampleValues    String   @default("[]")
  intelSuggestedLabel   String?
  intelSuggestedPlaceholder String?
  intelSuggestedHelpText String?
  intelIsSystemField    Boolean  @default(false)
  intelIsAuditField     Boolean  @default(false)
  intelIsCalculated     Boolean  @default(false)
  intelConfidence       Float    @default(0.0)

  // UI Component Layer
  uiComponentType       String?
  uiHtmlInputType       String?
  uiRenderAs            String?
  uiGridWidth           String   @default("col-md-6")
  uiLabelPosition       String   @default("left")
  uiGroupName           String?
  uiTabName             String?
  uiSectionName         String?
  uiIsHidden            Boolean  @default(false)
  uiIsReadOnly          Boolean  @default(false)
  uiIsDisabled          Boolean  @default(false)
  uiConditionalDisplay  String?
  uiDropdownConfig      String?  // JSON
  uiDateConfig          String?  // JSON
  uiFileConfig          String?  // JSON
  uiSopRulesApplied     String   @default("[]")
  uiConfidence          Float    @default(0.0)

  // Validation Layer
  validationIsRequired  Boolean  @default(false)
  validationClientRules String   @default("[]") // JSON: ClientValidationRule[]
  validationServerRules String   @default("[]") // JSON: ServerValidationRule[]
  validationCrossRules  String   @default("[]") // JSON: CrossFieldRule[]
  validationDbConstraints String  @default("[]") // JSON: DatabaseConstraint[]
  validationAlignment   String   @default("unknown") // full, partial, mismatch, unknown
  validationMissing     String   @default("[]")
  validationExcessive   String   @default("[]")
  validationConfidence  Float    @default(0.0)

  // Compliance Layer
  compSensitivityLevel  String   @default("public")
  compIsPII             Boolean  @default(false)
  compIsPHI             Boolean  @default(false)
  compIsFinancial       Boolean  @default(false)
  compPiiCategory       String?
  compPhiCategory       String?
  compRequiresEncryption Boolean @default(false)
  compRequiresMasking   Boolean  @default(false)
  compMaskingPattern    String?
  compRetentionPolicy   String?
  compConsentRequired   Boolean  @default(false)
  compAuditRequired     Boolean  @default(false)
  compAccessRestrictions String  @default("[]")
  compRegulatoryFrameworks String @default("[]")
  compConfidence        Float    @default(0.0)

  // Complexity Layer
  complexityPoints      Float    @default(0.0)
  complexityFactors     String   @default("[]") // JSON: ComplexityFactor[]
  complexityFrontendHrs Float    @default(0.0)
  complexityBackendHrs  Float    @default(0.0)
  complexityTestingHrs  Float    @default(0.0)
  complexityMigrationRisk String @default("low")

  // SOP Layer
  sopAppliedRules       String   @default("[]") // JSON: AppliedSOPRule[]
  sopTotalApplicable    Int      @default(0)
  sopTotalCompliant     Int      @default(0)
  sopCompliancePercent  Float    @default(0.0)
  sopViolations         String   @default("[]")
  sopAutoFixable        String   @default("[]")

  // CSHTML Evidence Layer
  cshtmlFoundInViews    String   @default("[]") // JSON: CSHTMLViewEvidence[]
  cshtmlAjaxEndpoints   String   @default("[]") // JSON: AjaxEndpoint[]
  cshtmlJsValidation    String   @default("[]")
  cshtmlCssClasses      String   @default("[]")
  cshtmlInlineStyles    String   @default("[]")
  cshtmlDataAttributes  String   @default("{}")

  // SP Evidence Layer
  spUsedInSPs           String   @default("[]") // JSON: SPUsageEvidence[]
  spBusinessRules       String   @default("[]") // JSON: SPBusinessRuleEvidence[]
  spErrorCodes          String   @default("[]") // JSON: SPErrorCodeEvidence[]

  // Test Cases Layer
  testCases             String   @default("[]") // JSON: FieldTestCase[]

  // Documentation Layer
  docDataDictionary     String   @default("{}") // JSON: DataDictionaryEntry
  docDeveloperNotes     String?
  docUserGuideText      String?
  docApiDocumentation   String?

  // Meta Layer
  metaEnrichedBy        String   @default("[]") // JSON: string[] - agent names
  metaEnrichmentComplete Float   @default(0.0)
  metaOverallConfidence Float    @default(0.0)
  metaNeedsReview       Boolean  @default(false)
  metaReviewNotes       String   @default("[]")
  metaVersion           Int      @default(1)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  validationRules       UnifiedFieldValidation[]
  testCasesRel          UnifiedFieldTestCase[]
  sopComplianceRecords  UnifiedFieldSOPCompliance[]
  cshtmlEvidenceRecords UnifiedFieldCSHTMLEvidence[]
  spEvidenceRecords     UnifiedFieldSPEvidence[]
  documentationRecords  UnifiedFieldDocumentation[]

  @@unique([projectId, tableName, fieldName])
  @@index([projectId])
  @@index([tableName])
  @@index([fkIsForeignKey])
  @@index([compIsPII])
  @@index([compIsPHI])
  @@index([metaNeedsReview])
  @@index([metaOverallConfidence])
  @@index([qualifiedName])
}

/// Field Validation Rule (1:M from UnifiedField)
model UnifiedFieldValidation {
  id              String   @id @default(cuid())
  fieldId         String
  field           UnifiedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  side            String   // "client", "server", "database", "cross_field"
  ruleType        String   // "notEmpty", "regexp", "remote", "digits", "email", "unique", "exists"
  ruleValue       String?  // regexp pattern, related field name, etc.
  errorMessage    String?
