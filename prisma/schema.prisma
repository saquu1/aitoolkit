// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// EXISTING MODELS
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  
  // Multi-tenant fields
  passwordHash    String?
  firstName       String?
  lastName        String?
  displayName     String?
  avatar          String?
  timezone        String   @default("UTC")
  locale          String   @default("en")
  
  // Status
  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  
  // Settings (JSON)
  preferences     String   @default("{}") // UserPreferences JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  userCompanies   UserCompany[]
  userProjects    UserProject[]
  posts           Post[]
  
  @@index([email])
  @@index([isActive])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relation
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([authorId])
}

// ============================================================================
// AGENT SYSTEM MODELS
// ============================================================================

/// Agent definition registered in the system
model AgentDefinition {
  id              String   @id @default(cuid())
  agentId         String   @unique // e.g., "schema.1"
  name            String
  layer           String   // schema, intelligence, module, requirements, generation, migration, management
  description     String
  version         String   @default("1.0.0")
  tags            String   // JSON array of tags
  dependencies    String   @default("[]") // JSON array of agent IDs
  requiresAI      Boolean  @default(false)
  estimatedDuration Int    @default(60) // seconds
  enabled         Boolean  @default(true)
  registeredAt    DateTime @default(now())
  lastModified    DateTime @updatedAt

  // Relations
  executions      AgentExecution[]
  logs            AgentLog[]

  @@index([layer])
  @@index([enabled])
}

/// Pipeline configuration
model PipelineConfig {
  id              String   @id @default(cuid())
  name            String
  description     String?
  config          String   // JSON configuration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  executions      PipelineExecution[]

  @@index([name])
}

/// Pipeline execution record
model PipelineExecution {
  id              String   @id @default(cuid())
  executionId     String   @unique
  pipelineId      String
  pipelineName    String
  status          String   // idle, initializing, running, paused, completed, failed, cancelled
  startTime       DateTime @default(now())
  endTime         DateTime?
  duration        Int?     // milliseconds
  
  // Configuration snapshot
  aiEngine        String   @default("offline")
  aiModel         String?
  stopOnError     Boolean  @default(true)
  
  // Summary
  totalAgents     Int      @default(0)
  completedAgents Int      @default(0)
  failedAgents    Int      @default(0)
  skippedAgents   Int      @default(0)
  itemsProcessed  Int      @default(0)
  
  // Output
  outputFiles     String   @default("[]") // JSON array of file paths
  errors          String   @default("[]") // JSON array of errors
  
  // Relations
  config          PipelineConfig @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  agentExecutions AgentExecution[]

  @@index([status])
  @@index([startTime])
  @@index([pipelineId])
}

/// Agent execution record
model AgentExecution {
  id              String   @id @default(cuid())
  executionId     String
  pipelineExecutionId String
  
  // Agent info
  agentId         String
  agentName       String
  
  // Execution state
  status          String   // idle, running, completed, failed, skipped, pending
  startTime       DateTime @default(now())
  endTime         DateTime?
  duration        Int?     // milliseconds
  
  // Results
  output          String?  // JSON output data
  error           String?
  itemsProcessed  Int      @default(0)
  retryCount      Int      @default(0)
  
  // Relations
  agent           AgentDefinition   @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  pipeline        PipelineExecution @relation(fields: [pipelineExecutionId], references: [id], onDelete: Cascade)
  logs            AgentLog[]

  @@unique([executionId, agentId])
  @@index([status])
  @@index([startTime])
  @@index([agentId])
  @@index([pipelineExecutionId])
}

/// Agent execution log entry
model AgentLog {
  id              String   @id @default(cuid())
  agentExecutionId String?
  agentDefinitionId String?
  
  // Log content
  timestamp       DateTime @default(now())
  level           String   // debug, info, warn, error
  message         String
  data            String?  // JSON additional data
  
  // Relations
  agentExecution  AgentExecution?  @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
  agentDefinition AgentDefinition? @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([level])
  @@index([agentExecutionId])
  @@index([agentDefinitionId])
}

/// Context snapshot for save/restore
model ContextSnapshot {
  id              String   @id @default(cuid())
  snapshotId      String   @unique
  description     String?
  data            String   // JSON context data
  triggeredBy     String?  // Agent ID that triggered snapshot
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// Source file record
model SourceFile {
  id              String   @id @default(cuid())
  name            String
  path            String
  type            String   // sql, cshtml, cs, json, xml, unknown
  size            Int
  contentHash     String
  content         String
  modifiedAt      DateTime @default(now())
  uploadedAt      DateTime @default(now())

  @@unique([path])
  @@index([type])
  @@index([uploadedAt])
}

/// Parsed schema table (cached result)
model ParsedSchemaTable {
  id              String   @id @default(cuid())
  tableName       String
  schema          String?
  sourceFileId    String?
  columns         String   // JSON columns definition
  primaryKey      String   // JSON array
  foreignKeys     String   @default("[]") // JSON array
  indexes         String   @default("[]") // JSON array
  constraints     String   @default("[]") // JSON array
  sourceDDL       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tableName, schema])
  @@index([tableName])
}

/// Parsed stored procedure (cached result)
model ParsedStoredProcedureRecord {
  id              String   @id @default(cuid())
  procedureName   String
  schema          String?
  sourceFileId    String?
  parameters      String   // JSON parameters
  returnType      String?
  body            String
  operations      String   @default("[]") // JSON array
  tablesAccessed  String   @default("[]") // JSON array
  tablesModified  String   @default("[]") // JSON array
  complexity      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([procedureName, schema])
  @@index([procedureName])
}

/// Module definition (generated by Module Layer)
model ModuleDefinition {
  id              String   @id @default(cuid())
  moduleId        String   @unique
  name            String
  description     String?
  category        String?
  tables          String   @default("[]") // JSON array
  procedures      String   @default("[]") // JSON array
  views           String   @default("[]") // JSON array
  screens         String   @default("[]") // JSON array
  priority        Int      @default(0)
  complexity      String   @default("medium") // low, medium, high, very_high
  estimatedHours  Float    @default(0)
  dependencies    String   @default("[]") // JSON array
  businessValue   String   @default("medium") // critical, high, medium, low
  status          String   @default("pending") // pending, in_progress, completed, blocked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([priority])
}

/// User story (generated by Requirements Layer)
model UserStoryRecord {
  id              String   @id @default(cuid())
  storyId         String   @unique
  title           String
  role            String
  feature         String
  benefit         String
  acceptanceCriteria String @default("[]") // JSON array
  moduleId        String?
  tables          String   @default("[]") // JSON array
  priority        String   @default("should_have") // must_have, should_have, could_have, wont_have
  storyPoints     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@index([priority])
  @@index([moduleId])
}

/// Generated artifact (output from Generation Layer)
model GeneratedArtifact {
  id              String   @id @default(cuid())
  artifactId      String   @unique
  type            String   // prisma_schema, api_spec, screen_blueprint, test_case, documentation
  name            String
  content         String   // Generated content
  sourceModule    String?
  sourceTable     String?
  metadata        String   @default("{}") // JSON metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([name])
}

/// System settings
model SystemSettings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  updatedAt       DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// SCHEMA TOOLKIT MODELS
// ============================================================================

/// Schema Toolkit Project - stores uploaded SQL and parsed results
model ToolkitProject {
  id              String   @id @default(cuid())
  name            String
  description     String?
  softwareType    String   @default("Custom") // HIS, ERP, CRM, E-Commerce, LMS, Custom
  targetTemplate  String   @default("nextjs-react") // nextjs-react, nextjs-pages, laravel, dotnet-mvc, flutter
  rawSql          String   @default("")
  status          String   @default("active") // active, archived, completed
  color           String   @default("#3b82f6") // Project color for UI
  icon            String   @default("Database") // Lucide icon name
  
  // Export tracking
  lastExportAt    DateTime?
  exportCount     Int      @default(0)
  lastExportPath  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  files           ToolkitFile[]
  tables          ToolkitTable[]
  procedures      ToolkitProcedure[]
  cshtmlViews     CSHTMLAnalysisCache[]
  storedProcCache StoredProcedureCache[]
  viewCache       ViewIntelligenceCache[]
  discoveredTables DiscoveredTableCache[]

  @@index([name])
  @@index([softwareType])
  @@index([status])
}

/// Project File - stores uploaded files (SQL, CSHTML, JS, etc.)
model ToolkitFile {
  id              String   @id @default(cuid())
  projectId       String
  
  // File info
  fileName        String
  filePath        String?
  fileType        String   // sql_ddl, sql_sp, sql_view, cshtml, javascript, typescript, config
  fileSize        Int      @default(0)
  lineCount       Int      @default(0)
  
  // Content
  content         String   @default("")
  contentHash     String?
  
  // Parse status
  parseStatus     String   @default("pending") // pending, parsing, parsed, error
  parseError      String?
  parsedAt        DateTime?
  
  // Intelligence summary
  tablesFound     Int      @default(0)
  proceduresFound Int      @default(0)
  complexity      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fileName])
  @@index([projectId])
  @@index([fileType])
  @@index([parseStatus])
}

/// Parsed table from SQL upload
model ToolkitTable {
  id              String   @id @default(cuid())
  projectId       String
  tableName       String
  schemaName      String   @default("dbo")
  columns         String   // JSON columns definition
  foreignKeys     String   @default("[]") // JSON array
  indexes         String   @default("[]") // JSON array
  constraints     String   @default("[]") // JSON array
  sourceDDL       String?
  status          String   @default("standalone") // complete, partial, missing, standalone
  linkedModule    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName])
  @@index([tableName])
}

/// Parsed stored procedure from SQL upload
model ToolkitProcedure {
  id              String   @id @default(cuid())
  projectId       String
  procedureName   String
  schemaName      String   @default("dbo")
  parameters      String   // JSON parameters
  returnType      String?
  body            String
  operations      String   @default("[]") // JSON array
  tablesAccessed  String   @default("[]") // JSON array
  tablesModified  String   @default("[]") // JSON array
  complexity      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, procedureName])
  @@index([procedureName])
}

/// Generated UAT test case
model ToolkitTestCase {
  id              String   @id @default(cuid())
  projectId       String
  testCaseId      String   // TC-001, TC-002, etc.
  module          String
  testCase        String
  description     String
  preconditions   String
  steps           String   // JSON array
  expectedResult  String
  priority        String   @default("Medium") // High, Medium, Low
  status          String   @default("Not Started") // Not Started, In Progress, Passed, Failed, Blocked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([module])
}

/// Generated user story
model ToolkitUserStory {
  id              String   @id @default(cuid())
  projectId       String
  storyId         String   // US-001, US-002, etc.
  title           String
  role            String
  feature         String
  benefit         String
  acceptanceCriteria String @default("[]") // JSON array
  priority        String   @default("should_have") // must_have, should_have, could_have, wont_have
  storyPoints     Int      @default(0)
  tables          String   @default("[]") // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([priority])
}

/// Generated artifact from toolkit
model ToolkitArtifact {
  id              String   @id @default(cuid())
  projectId       String
  artifactType    String   // prisma_schema, erd, documentation, uat, flow, user_stories
  name            String
  content         String   // Generated content
  metadata        String   @default("{}") // JSON metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([artifactType])
}

// ============================================================================
// AI CONVERSATION MODELS
// ============================================================================

/// AI Conversation session
model AIConversation {
  id              String   @id @default(cuid())
  title           String
  context         String   @default("general") // general, schema, module, requirements
  projectId       String?
  messages        AIMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([context])
}

/// AI Message in a conversation
model AIMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // user, ai, system
  content         String
  metadata        String?  // JSON for structured data
  createdAt       DateTime @default(now())

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
}

// ============================================================================
// MODULE TRACKING MODELS
// ============================================================================

/// HIS Module Registry entry
model HISModule {
  id              String   @id @default(cuid())
  moduleKey       String   @unique
  moduleName      String
  description     String?
  layer           Int      // 1-7
  layerName       String
  priority        String   @default("medium") // critical, high, medium, low
  estimatedDays   Int      @default(0)
  tables          String   @default("[]") // JSON array
  dependsOn       String   @default("[]") // JSON array
  features        String   @default("[]") // JSON array
  userRoles       String   @default("[]") // JSON array
  revenue         Boolean  @default(false)
  status          String   @default("planned") // planned, in_progress, completed, blocked
  progress        Int      @default(0) // 0-100
  assignedTo      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([layer])
  @@index([status])
  @@index([priority])
}

/// Column Intelligence cache
model ColumnIntelligenceCache {
  id              String   @id @default(cuid())
  tableName       String
  columnName      String
  semanticType    String
  uiType          String
  sensitivity     String
  confidence      Int
  validationRules String   @default("[]") // JSON array
  suggestions     String   @default("[]") // JSON array
  isSearchable    Boolean  @default(false)
  isFilterable    Boolean  @default(false)
  displayInList   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tableName, columnName])
  @@index([tableName])
  @@index([semanticType])
}

/// FK Dependency analysis cache
model FKDependencyCache {
  id              String   @id @default(cuid())
  projectId       String
  tableName       String
  totalFKs        Int      @default(0)
  resolvedFKs     Int      @default(0)
  missingTables   String   @default("[]") // JSON array
  analysisData    String   @default("{}") // JSON full analysis
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, tableName])
  @@index([projectId])
}

// ============================================================================
// STORED PROCEDURE & VIEW INTELLIGENCE MODELS (Step 7 & 9)
// ============================================================================

/// Stored Procedure Intelligence Cache
model StoredProcedureCache {
  id                    String   @id @default(cuid())
  projectId             String
  procedureName         String
  schemaName            String   @default("dbo")
  
  // Classification
  actionType            String   @default("unknown") // dropdown, read, create, update, delete, search, report, validate, process
  moduleName            String?
  moduleConfidence      Int      @default(0)
  
  // Dependencies
  tablesReferenced      String   @default("[]") // JSON: TableDependency[]
  implicitJoins         String   @default("[]") // JSON: SPJoinRelationship[]
  discoveredTables      String   @default("[]") // JSON: DiscoveredTable[]
  
  // Business Logic
  businessRules         String   @default("[]") // JSON: BusinessFilterRule[]
  writeOperations       String   @default("[]") // JSON: SQLOperation[]
  readOperations        String   @default("[]") // JSON: SQLOperation[]
  
  // API Schema
  parameters            String   @default("[]") // JSON: ProcedureParameter[]
  apiInputSchema        String   @default("{}") // JSON: APIInputSchema
  
  // Analysis
  complexity            Int      @default(0)
  riskLevel             String   @default("low") // low, medium, high, critical
  suggestedEndpoint     String?
  
  // Raw
  body                  String   @default("")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relation
  project               ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, procedureName])
  @@index([projectId])
  @@index([actionType])
  @@index([moduleName])
}

/// View Intelligence Cache
model ViewIntelligenceCache {
  id                    String   @id @default(cuid())
  projectId             String
  viewName              String
  schemaName            String   @default("dbo")
  
  // Structure
  sourceTables          String   @default("[]") // JSON: string[]
  joinRelationships     String   @default("[]") // JSON: ViewJoinRelationship[]
  columns               String   @default("[]") // JSON: ViewColumn[]
  
  // Intelligence
  calculatedFields      String   @default("[]") // JSON: CalculatedField[]
  caseStatements        String   @default("[]") // JSON: CaseStatementMapping[]
  purpose               String   @default("unknown") // report, dashboard, lookup, api
  businessContext       String?
  
  // Suggestions
  suggestedReportType   String?
  suggestedWidgets      String   @default("[]") // JSON: string[]
  enumSuggestions       String   @default("[]") // JSON: EnumSuggestion[]
  apiEndpoints          String   @default("[]") // JSON: string[]
  
  // Analysis
  complexity            Int      @default(0)
  hiddenRelationships   String   @default("[]") // JSON: HiddenRelationship[]
  
  // Raw
  body                  String   @default("")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relation
  project               ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, viewName])
  @@index([projectId])
  @@index([purpose])
}

/// Discovered Table (referenced in SP/View but not in DDL)
model DiscoveredTableCache {
  id              String   @id @default(cuid())
  projectId       String
  tableName       String
  discoveredInSP  String?  // SP name where discovered
  discoveredInView String? // View name where discovered
  accessType      String   @default("read") // read, write
  columns         String   @default("[]") // JSON: string[]
  suggestedModule String?
  priority        String   @default("medium") // high, medium, low
  isResolved      Boolean  @default(false)
  resolvedTableId String?  // Link to actual table once uploaded
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relation
  project         ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName])
  @@index([projectId])
  @@index([priority])
  @@index([isResolved])
}

// ============================================================================
// MULTI-TENANT ARCHITECTURE MODELS (Step 5)
// ============================================================================

/// Company/Organization - Top-level tenant entity
model Company {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  logo                String?
  primaryColor        String?
  secondaryColor      String?
  domain              String?   // Custom domain for white-labeling
  
  // Subscription
  subscriptionTier    String    @default("free") // free, starter, professional, enterprise
  subscriptionStatus  String    @default("trialing") // active, past_due, cancelled, trialing
  stripeCustomerId    String?
  stripeSubscriptionId String?
  trialEndsAt         DateTime?
  
  // Billing
  billingEmail        String?
  billingName         String?
  billingAddress      String?   // JSON address object
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String?
  
  // Settings (JSON)
  settings            String    @default("{}") // CompanySettings JSON
  limits              String    @default("{}") // TenantLimits JSON
  usage               String    @default("{}") // TenantUsage JSON
  
  // Status
  isActive            Boolean   @default(true)
  
  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  workspaces          Workspace[]
  userCompanies       UserCompany[]
  projects            Project[]
  apiKeys             APIKey[]
  auditLogs           AuditLog[]
  
  @@index([slug])
  @@index([subscriptionTier])
  @@index([subscriptionStatus])
  @@index([isActive])
}

/// Workspace - Organization unit within a Company
model Workspace {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  slug            String
  description     String?
  
  // Settings (JSON)
  settings        String    @default("{}") // WorkspaceSettings JSON
  
  // Status
  isActive        Boolean   @default(true)
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects        Project[]
  
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([isActive])
}

/// Project - Individual schema project
model Project {
  id              String    @id @default(cuid())
  workspaceId     String?
  companyId       String
  
  // Project info
  name            String
  slug            String
  description     String?
  softwareType    String    @default("Custom") // HIS, ERP, CRM, E-Commerce, LMS, Custom
  
  // Status
  status          String    @default("planning") // planning, in_development, testing, production, archived
  
  // Settings (JSON)
  settings        String    @default("{}") // ProjectSettings JSON
  statistics      String    @default("{}") // ProjectStatistics JSON
  
  // Owner
  createdBy       String?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userProjects    UserProject[]
  
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([workspaceId])
  @@index([status])
  @@index([softwareType])
}

/// User-Company relationship (Company membership)
model UserCompany {
  id              String    @id @default(cuid())
  userId          String
  companyId       String
  
  // Role
  role            String    @default("member") // owner, admin, member
  
  // Status
  status          String    @default("pending") // pending, active, suspended, removed
  
  // Invitation
  invitedBy       String?
  invitedAt       DateTime?
  joinedAt        DateTime?
  
  // Settings (JSON)
  settings        String    @default("{}") // UserCompanySettings JSON
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
