  // Run Identity
  runId             String   @unique
  
  // Agent Info
  agentName         String   // e.g., "URLGeneratorAgent"
  agentVersion      String   @default("1.0.0")
  
  // Status
  status            String   @default("pending") // pending, running, completed, failed, cancelled
  
  // Timing
