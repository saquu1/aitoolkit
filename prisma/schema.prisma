generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AIConversation {
  id        String      @id
  title     String
  context   String      @default("general")
  projectId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  AIMessage AIMessage[]

  @@index([context])
  @@index([projectId])
}

model AIMessage {
  id             String         @id
  conversationId String
  role           String
  content        String
  metadata       String?
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([conversationId])
}

model AIQuestionRecord {
  id                String   @id
  questionId        String   @unique
  category          String
  question          String
  context           String?
  options           String   @default("[]")
  allowsMultiple    Boolean  @default(false)
  allowsCustomInput Boolean  @default(false)
  priority          String   @default("medium")
  impact            String?
  defaultValue      String?
  answer            String?
  relatedColumns    String   @default("[]")
  relatedTables     String   @default("[]")
  tableName         String?
  moduleName        String?
  sessionId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([sessionId])
  @@index([tableName])
  @@index([priority])
  @@index([category])
}

model APIEndpoint {
  id            String     @id
  controllerId  String
  endpointKey   String     @unique
  methodName    String
  httpMethod    String     @default("GET")
  route         String
  routePrefix   String?
  parameters    String     @default("[]")
  requestBody   String?
  responseBody  String?
  responseType  String?
  sourceSP      String?
  sourceTable   String?
  requiresAuth  Boolean    @default(true)
  requiredRoles String     @default("[]")
  summary       String?
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  Controller    Controller @relation(fields: [controllerId], references: [id], onDelete: Cascade)

  @@index([sourceSP])
  @@index([httpMethod])
  @@index([controllerId])
}

model APIGenerationResult {
  id                   String    @id
  projectId            String
  moduleName           String
  entityName           String
  sourceSPs            String    @default("[]")
  sourceTables         String    @default("[]")
  routeFilePath        String
  routeFileContent     String
  typeFilePath         String?
  typeFileContent      String?
  validationFilePath   String?
  validationContent    String?
  testFilePath         String?
  testFileContent      String?
  generationConfidence Float     @default(0.0)
  compilable           Boolean   @default(false)
  hasTypeErrors        Boolean   @default(false)
  warningCount         Int       @default(0)
  errorCount           Int       @default(0)
  validationLog        String    @default("[]")
  status               String    @default("generated")
  reviewedBy           String?
  reviewedAt           DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime

  @@unique([projectId, moduleName, entityName])
  @@index([status])
  @@index([entityName])
  @@index([moduleName])
  @@index([projectId])
}

model APIKey {
  id          String    @id
  companyId   String
  name        String
  keyHash     String    @unique
  prefix      String
  permissions String    @default("[]")
  rateLimit   Int       @default(1000)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([prefix])
  @@index([companyId])
}

model APIRouteGeneration {
  id                    String    @id
  projectId             String
  spName                String
  httpMethod            String
  routePath             String
  routeName             String
  moduleName            String?
  entityName            String?
  generatedTypeScript   String?
  generatedZodSchema    String?
  generatedTypes        String?
  importsSection        String    @default("")
  schemaSection         String    @default("")
  handlerSection        String    @default("")
  middlewareSection     String    @default("")
  errorHandlingSection  String    @default("")
  parameterMappings     String    @default("[]")
  responseMapping       String    @default("{}")
  errorMappings         String    @default("[]")
  requiredMiddleware    String    @default("[]")
  requiredPermissions   String    @default("[]")
  generationConfidence  Float     @default(0.0)
  generationSource      String    @default("sp")
  generationVersion     Int       @default(1)
  status                String    @default("generated")
  reviewedBy            String?
  reviewedAt            DateTime?
  implementedAt         DateTime?
  deployedAt            DateTime?
  testCoverage          Float     @default(0.0)
  documentationComplete Boolean   @default(false)
  outputFilePath        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime

  @@unique([projectId, spName, httpMethod])
  @@index([status])
  @@index([moduleName])
  @@index([httpMethod])
  @@index([spName])
  @@index([projectId])
}

model AgentDefinition {
  id                String           @id
  agentId           String           @unique
  name              String
  layer             String
  description       String
  version           String           @default("1.0.0")
  tags              String
  dependencies      String           @default("[]")
  requiresAI        Boolean          @default(false)
  estimatedDuration Int              @default(60)
  enabled           Boolean          @default(true)
  registeredAt      DateTime         @default(now())
  lastModified      DateTime
  AgentExecution    AgentExecution[]
  AgentLog          AgentLog[]

  @@index([enabled])
  @@index([layer])
}

model AgentExecution {
  id                  String            @id
  executionId         String
  pipelineExecutionId String
  agentId             String
  agentName           String
  status              String
  startTime           DateTime          @default(now())
  endTime             DateTime?
  duration            Int?
  output              String?
  error               String?
  itemsProcessed      Int               @default(0)
  retryCount          Int               @default(0)
  AgentDefinition     AgentDefinition   @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  PipelineExecution   PipelineExecution @relation(fields: [pipelineExecutionId], references: [id], onDelete: Cascade)
  AgentLog            AgentLog[]

  @@unique([executionId, agentId])
  @@index([pipelineExecutionId])
  @@index([agentId])
  @@index([startTime])
  @@index([status])
}

model AgentLog {
  id                String           @id
  agentExecutionId  String?
  agentDefinitionId String?
  timestamp         DateTime         @default(now())
  level             String
  message           String
  data              String?
  AgentExecution    AgentExecution?  @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
  AgentDefinition   AgentDefinition? @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)

  @@index([agentDefinitionId])
  @@index([agentExecutionId])
  @@index([level])
  @@index([timestamp])
}

model AgentMessage {
  id          String   @id
  runId       String
  messageId   String   @unique
  messageType String
  message     String
  payload     String   @default("{}")
  timestamp   DateTime @default(now())
  AgentRun    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([messageType])
  @@index([runId])
}

model AgentRun {
  id             String         @id
  projectId      String
  runId          String         @unique
  agentName      String
  agentVersion   String         @default("1.0.0")
  status         String         @default("pending")
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  duration       Int?
  inputConfig    String         @default("{}")
  outputData     String         @default("{}")
  itemsProcessed Int            @default(0)
  itemsProduced  Int            @default(0)
  error          String?
  errorStack     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  AgentMessage   AgentMessage[]

  @@index([startedAt])
  @@index([status])
  @@index([agentName])
  @@index([projectId])
}

model AjaxCallCache {
  id              String   @id
  projectId       String
  jsFileId        String?
  callId          String
  url             String
  method          String   @default("GET")
  dataType        String?
  contentType     String?
  isAsync         Boolean  @default(true)
  parameters      String   @default("[]")
  successCallback String?
  errorCallback   String?
  sourceFile      String
  lineNumber      Int?
  context         String?
  linkedSP        String?
  linkedEndpoint  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([method])
  @@index([url])
  @@index([projectId])
}

model AuditLog {
  id         String   @id
  companyId  String
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([resource])
  @@index([action])
  @@index([userId])
  @@index([companyId])
}

model RawImportData {
  id           String        @id @default(cuid())
  sourceType   String        @default("batch_import")
  sourceUrl    String?
  sourceChatId String?
  rawJson      String
  rawSizeBytes Int           @default(0)
  messageCount Int           @default(0)
  parseStatus  String        @default("pending")
  parseError   String?
  parsedAt     DateTime?
  importedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatLog      ChatLog?
  dataLinks    RawDataLink[]

  @@index([sourceType])
  @@index([sourceChatId])
  @@index([importedAt])
  @@index([parseStatus])
}

model RawDataLink {
  id                   String        @id @default(cuid())
  rawDataId            String
  chainLevel           Int           @default(0)
  chainOrder           Int           @default(0)
  entityType           String
  entityId             String
  entityName           String?
  extractionPath       String?
  extractionConfidence Float         @default(1.0)
  extractionMethod     String?       @default("auto")
  sourceRawDataId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  RawImportData        RawImportData @relation(fields: [rawDataId], references: [id], onDelete: Cascade)

  @@unique([rawDataId, entityType, entityId])
  @@index([rawDataId])
  @@index([entityType, entityId])
  @@index([chainLevel])
}

model ChatLog {
  id            String         @id
  sessionId     String         @unique
  sessionDate   String
  title         String
  summary       String         @default("")
  issuesSolved  String         @default("[]")
  featuresAdded String         @default("[]")
  filesModified String         @default("[]")
  commits       String         @default("[]")
  notes         String         @default("")
  source        String         @default("manual")
  importedAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  rawDataId     String?        @unique
  RawImportData RawImportData? @relation(fields: [rawDataId], references: [id])

  @@index([sessionDate])
  @@index([source])
  @@index([importedAt])
  @@index([rawDataId])
}

model Building {
  id          String   @id
  name        String
  description String?
  code        String?  @unique
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Floor       Floor[]

  @@index([code])
  @@index([isActive])
  @@index([name])
}

model BusinessRuleRecord {
  id          String    @id
  ruleId      String    @unique
  code        String    @unique
  name        String
  description String?
  category    String
  priority    String    @default("medium")
  status      String    @default("draft")
  tableName   String?
  moduleName  String?
  trigger     String
  condition   String
  action      String
  exception   String?
  examples    String    @default("[]")
  impact      String?
  approvedBy  String?
  approvedAt  DateTime?
  version     Int       @default(1)
  tags        String    @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([moduleName])
  @@index([tableName])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([name])
}

model CSHTMLAjaxEndpoint {
  id                    String   @id
  projectId             String
  cshtmlViewName        String
  endpointUrl           String
  httpMethod            String   @default("GET")
  dataType              String?
  parameters            String   @default("[]")
  successCallback       String?
  errorCallback         String?
  lineNumber            Int?
  context               String?
  linkedSP              String?
  linkedController      String?
  linkedAction          String?
  correlationConfidence Float    @default(0.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  @@unique([projectId, cshtmlViewName, endpointUrl])
  @@index([linkedSP])
  @@index([cshtmlViewName])
  @@index([projectId])
}

model CSHTMLAnalysisCache {
  id              String         @id
  projectId       String
  viewName        String
  filePath        String?
  viewType        String         @default("unknown")
  modelName       String?
  linkedTable     String?
  title           String?
  layout          String?
  fields          String         @default("[]")
  listConfig      String         @default("{}")
  sections        String         @default("[]")
  permissions     String         @default("[]")
  scripts         String         @default("[]")
  styles          String         @default("[]")
  reactBlueprint  String         @default("{}")
  suggestedPath   String?
  estimatedEffort Int            @default(0)
  rawContent      String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  ToolkitProject  ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, viewName])
  @@index([linkedTable])
  @@index([viewType])
  @@index([projectId])
}

model CSHTMLFormIntelligence {
  id                      String   @id
  projectId               String
  viewName                String
  formId                  String?
  formName                String?
  actionUrl               String?
  httpMethod              String   @default("POST")
  enctype                 String   @default("application/x-www-form-urlencoded")
  controllerName          String?
  actionName              String?
  fields                  String   @default("[]")
  jqueryValidateRules     String   @default("{}")
  bootstrapValidator      String   @default("{}")
  customValidation        String   @default("[]")
  dropdowns               String   @default("[]")
  ajaxCalls               String   @default("[]")
  correlatedSP            String?
  correlationType         String?
  correlationConfidence   Float    @default(0.0)
  submitHandler           String?
  successHandler          String?
  errorHandler            String?
  errorCodesHandled       String   @default("{}")
  csrfEnabled             Boolean  @default(false)
  antiForgeryToken        Boolean  @default(false)
  suggestedReactComponent String?
  suggestedZodSchema      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime

  @@unique([projectId, viewName, formName])
  @@index([correlatedSP])
  @@index([controllerName])
  @@index([viewName])
  @@index([projectId])
}

model CodeEmbedding {
  id             String   @id
  projectId      String
  entityType     String
  entityId       String
  content        String
  embedding      String?
  embeddingModel String?
  tokenCount     Int      @default(0)
  contentHash    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@unique([projectId, entityType, entityId])
  @@index([entityId])
  @@index([entityType])
  @@index([projectId])
}

model ColumnIntelligenceCache {
  id              String   @id
  tableName       String
  columnName      String
  semanticType    String
  uiType          String
  sensitivity     String
  confidence      Int
  validationRules String   @default("[]")
  suggestions     String   @default("[]")
  isSearchable    Boolean  @default(false)
  isFilterable    Boolean  @default(false)
  displayInList   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([tableName, columnName])
  @@index([semanticType])
  @@index([tableName])
}

model Company {
  id                   String        @id
  name                 String
  slug                 String        @unique
  logo                 String?
  primaryColor         String?
  secondaryColor       String?
  domain               String?
  subscriptionTier     String        @default("free")
  subscriptionStatus   String        @default("trialing")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?
  billingEmail         String?
  billingName          String?
  billingAddress       String?
  billingCity          String?
  billingState         String?
  billingPostalCode    String?
  billingCountry       String?
  settings             String        @default("{}")
  limits               String        @default("{}")
  usage                String        @default("{}")
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  APIKey               APIKey[]
  AuditLog             AuditLog[]
  Project              Project[]
  UserCompany          UserCompany[]
  Workspace            Workspace[]

  @@index([isActive])
  @@index([subscriptionStatus])
  @@index([subscriptionTier])
  @@index([slug])
}

model ConfidenceScore {
  id         String    @id
  projectId  String?
  entityType String
  entityId   String
  score      Float
  confidence String
  factors    String    @default("[]")
  source     String    @default("inference")
  verifiedAt DateTime?
  verifiedBy String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([confidence])
  @@index([score])
  @@index([projectId])
}

model ConflictRule {
  id              String   @id
  name            String   @unique
  conflictType    String
  priority        Int      @default(10)
  resolution      String
  resolutionLogic String?
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([priority])
  @@index([active])
  @@index([conflictType])
}

model ContextSnapshot {
  id          String   @id
  snapshotId  String   @unique
  description String?
  data        String
  triggeredBy String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Controller {
  id            String        @id
  projectId     String
  moduleId      String?
  name          String
  controllerKey String        @unique
  filePath      String?
  sourceType    String        @default("mvc")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  APIEndpoint   APIEndpoint[]

  @@index([name])
  @@index([moduleId])
  @@index([projectId])
}

model DBConversionCache {
  id               String   @id
  projectId        String
  conversionId     String   @unique
  sourceType       String   @default("sqlserver")
  targetType       String   @default("postgresql")
  tablesConverted  Int      @default(0)
  columnsConverted Int      @default(0)
  fksConverted     Int      @default(0)
  spsConverted     Int      @default(0)
  viewsConverted   Int      @default(0)
  postgresDDL      String   @default("")
  prismaSchema     String   @default("")
  nodeJSOutlines   String   @default("[]")
  typeConversions  String   @default("[]")
  warnings         String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([projectId])
}

model DLLIntelligence {
  id                 String   @id
  projectId          String
  dllName            String
  dllVersion         String?
  controllers        String   @default("[]")
  controllerActions  String   @default("[]")
  routeMappings      String   @default("[]")
  authorizationRules String   @default("[]")
  modelClasses       String   @default("[]")
  dtoClasses         String   @default("[]")
  viewModels         String   @default("[]")
  enumerations       String   @default("[]")
  serviceClasses     String   @default("[]")
  repositoryClasses  String   @default("[]")
  helperClasses      String   @default("[]")
  nugetPackages      String   @default("[]")
  projectReferences  String   @default("[]")
  namespaces         String   @default("[]")
  isDecompiled       Boolean  @default(false)
  isAnalyzed         Boolean  @default(false)
  analysisMethod     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  @@unique([projectId, dllName])
  @@index([dllName])
  @@index([projectId])
}

model DataLineage {
  id                   String   @id
  projectId            String?
  entityType           String
  entityId             String
  entityName           String
  sourceType           String
  sourceAgent          String?
  sourceFileId         String?
  sourceFileName       String?
  sourceLineStart      Int?
  sourceLineEnd        Int?
  sourceCharStart      Int?
  sourceCharEnd        Int?
  extractionMethod     String   @default("direct_parse")
  extractionConfidence Float    @default(1.0)
  extractionTime       Int      @default(0)
  dependsOn            String   @default("[]")
  dependedBy           String   @default("[]")
  extractedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime

  @@unique([entityType, entityId])
  @@index([sourceAgent])
  @@index([sourceType])
  @@index([entityType])
  @@index([projectId])
}

model DecisionRecord {
  id               String    @id
  projectId        String
  decisionId       String    @unique
  title            String
  description      String?
  category         String    @default("architecture")
  context          String?
  problemStatement String?
  decision         String
  rationale        String?
  alternatives     String    @default("[]")
  impact           String    @default("medium")
  affectedAreas    String    @default("[]")
  status           String    @default("proposed")
  supersededBy     String?
  proposedBy       String?
  decidedBy        String?
  approvedBy       String?
  decidedAt        DateTime?
  approvedAt       DateTime?
  relatedDecisions String    @default("[]")
  relatedTables    String    @default("[]")
  relatedModules   String    @default("[]")
  tags             String    @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime

  @@index([impact])
  @@index([category])
  @@index([status])
  @@index([projectId])
}

model DiscoveredTableCache {
  id               String         @id
  projectId        String
  tableName        String
  discoveredInSP   String?
  discoveredInView String?
  accessType       String         @default("read")
  columns          String         @default("[]")
  suggestedModule  String?
  priority         String         @default("medium")
  isResolved       Boolean        @default(false)
  resolvedTableId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  ToolkitProject   ToolkitProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName])
  @@index([isResolved])
  @@index([priority])
  @@index([projectId])
}

model DropdownMapping {
  id               String   @id
  projectId        String
  cshtmlViewName   String
  dropdownId       String?
  dropdownName     String?
  ddlMethod        String?
  linkedSP         String?
  linkedTable      String?
  valueColumn      String?
  textColumn       String?
  parentDropdownId String?
  cascadeParameter String?
  confidence       Float    @default(0.0)
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@unique([projectId, cshtmlViewName, dropdownName])
  @@index([linkedTable])
  @@index([linkedSP])
  @@index([projectId])
}

model DropdownRegistry {
  id                String    @id
  projectId         String
  spName            String
  dropdownKey       String    @unique
  dropdownName      String
  description       String?
  sourceSP          String
  moduleName        String?
  parameters        String    @default("[]")
  supportsFiltering Boolean   @default(false)
  filterParameters  String    @default("[]")
  cascadeFrom       String?
  cascadeParameter  String?
  valueColumn       String    @default("Id")
  labelColumn       String    @default("Name")
  additionalColumns String    @default("[]")
  isCacheable       Boolean   @default(true)
  cacheTTL          Int       @default(3600)
  cacheKeyTemplate  String?
  defaultOption     String?
  emptyOption       Boolean   @default(false)
  searchEnabled     Boolean   @default(false)
  multiSelect       Boolean   @default(false)
  apiEndpoint       String?
  generatedAt       DateTime?
  usedInViews       String    @default("[]")
  usedInForms       String    @default("[]")
  totalOptions      Int?
  lastRefreshedAt   DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([isActive])
  @@index([cascadeFrom])
  @@index([moduleName])
  @@index([spName])
  @@index([projectId])
}

model ErrorCodeMapping {
  id                    String   @id
  projectId             String
  spName                String
  errorCode             Int
  spErrorMessage        String?
  spCondition           String?
  cshtmlViewName        String?
  cshtmlErrorHandler    String?
  cshtmlUserMessage     String?
  messageAlignment      String   @default("unknown")
  migratedErrorHandling String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  @@unique([projectId, spName, errorCode])
  @@index([spName])
  @@index([projectId])
}

model EventHandlerCache {
  id           String   @id
  projectId    String
  jsFileId     String?
  handlerId    String
