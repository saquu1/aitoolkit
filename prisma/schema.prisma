  fileType          String   // razor_view, controller, service, model, sql_ddl, sql_sp, etc.
  language          String   // csharp, vbnet, typescript, javascript, sql, razor
  framework         String   // aspnet_mvc, aspnet_core, react, vue, angular, unknown

  // Confidence
  confidence        Int      @default(0) // 0-100

  // Indicators
  indicators        String   @default("[]") // JSON: string[]

  // Suggested Parser
  suggestedParser   String?

  // Metadata
  fileSize          Int      @default(0)
  lineCount         Int      @default(0)
  estimatedComplexity String @default("low") // low, medium, high

  // Processing Status
  isProcessed       Boolean  @default(false)
  processedAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, filePath])
  @@index([projectId])
  @@index([fileType])
  @@index([language])
}

